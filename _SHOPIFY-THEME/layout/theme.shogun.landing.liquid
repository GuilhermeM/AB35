      window.SLIDECART_OPENED = function() {
        // Fires whenever Slide Cart has been opened
        let items_height = document.querySelector('#slidecarthq .items').clientHeight;;

        if (items_height >= (window.innerHeight/2)){

          document.querySelector('#slidecarthq .footer').classList.add('sticky-checkout')
          document.querySelector('#slidecarthq .footer').classList.remove ('no-sticky-checkout')

        } else {

          document.querySelector('#slidecarthq .footer').classList.remove ('sticky-checkout')
          document.querySelector('#slidecarthq .footer').classList.add ('no-sticky-checkout')
        }
      }
