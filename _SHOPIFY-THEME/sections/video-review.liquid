{% comment %}
  Section: Customer Videos
  Purpose: Displays a list of customer video testimonials with name, quote, and rating.
{% endcomment %}

<section class="customar-video">
  <div class="customar-video__inner">
    <div class="container">
      {% if section.settings.section_title != blank %}
        <div class="customar__video-title">
          <h2>{{ section.settings.section_title }}</h2>
        </div>
      {% endif %}

      <div class="customar-video__wrapper">
        <div class="customar__video-items">
          {% for block in section.blocks %}
            <div class="customar-video-card" {{ block.shopify_attributes }}>
              <div class="customar-video-card__img">
                {% if block.settings.video != blank %}
                  {% if block.settings.video.sources != blank %}
                    {%- comment -%} Media-type video {%- endcomment -%}
                    <video preload="none" playsinline poster="{{ block.settings.video.preview_image | image_url: width: 600 }}">
                      {% assign sources = block.settings.video.sources | where: "mime_type", "video/mp4" %}
                      {% for source in sources %}
                        <source src="{{ source.url }}#t=0.001" type="{{ source.mime_type }}">
                      {% endfor %}
                      Your browser does not support the video tag.
                    </video>
                  {% else %}
                    {%- comment -%} File-type video {%- endcomment -%}
                    <video preload="none" playsinline>
                      <source src="{{ block.settings.video | file_url }}#t=0.001" type="video/mp4">
                      Your browser does not support the video tag.
                    </video>
                  {% endif %}
                {% endif %}
                <div class="customar-video-card__playbtn">
                  <img src="{{ 'customar-video-btn.svg' | asset_url }}" alt="Play video">
                </div>
              </div>

              <div class="customar-video-card__content">
                <div class="customar-video-card__product-info">
                  <div class="customar-video-card__reating">
                    <img src="{{ 'customar-video-reating.svg' | asset_url }}" alt="Rating">
                  </div>
                  {% if block.settings.review_text != blank %}
                    <div class="customar-video-card__say">
                      <p>{{ block.settings.review_text }}</p>
                    </div>
                  {% endif %}
                </div>

                {% comment %} <div class="customar-video-card__name">
                  <div class="customar-video-card__reviewer">
                    {% if block.settings.reviewer_image != blank %}
                      <div class="customar-video-card__pic">
                        <img src="{{ block.settings.reviewer_image | image_url: width: 200 }}" alt="{{ block.settings.reviewer_name | default: 'Customer' }}" loading="lazy">
                      </div>
                    {% endif %}
                    {% if block.settings.reviewer_name != blank %}
                      <div class="customar-video-card__reviewer-name">
                        <h5>{{ block.settings.reviewer_name }}</h5>
                      </div>
                    {% endif %}
                  </div>
                  <div class="customar-video-card__verify">
                    <p>Verified Buyer</p>
                  </div>
                </div> {% endcomment %}
              </div>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.button_text != blank and section.settings.button_link != blank %}
          <div class="customar-video__btn-wrap">
            <a href="{{ section.settings.button_link }}" class="customar-video__btn">
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Videos",
  "tag": "section",
  "class": "customar-video",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Customer Videos"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Card",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Customer Video"
        },
        {
          "type": "text",
          "id": "review_text",
          "label": "Quote Text",
          "default": "“Amazing Quality”"
        }
        // {
        //   "type": "image_picker",
        //   "id": "reviewer_image",
        //   "label": "Reviewer Image"
        // },
        // {
        //   "type": "text",
        //   "id": "reviewer_name",
        //   "label": "Reviewer Name",
        //   "default": "Hanan T."
        // }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Videos",
      "blocks": [
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" }
      ]
    }
  ]
}
{% endschema %}
