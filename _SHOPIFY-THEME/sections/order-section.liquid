{% if section.settings.order_text != blank %}
<div class="about-order-section"{% if section.settings.bg_color != blank %} style="background-color:{{section.settings.bg_color}};"{% endif %}>
  <div class="container">
    <div class="order-wrapper">
      {% if section.settings.order_text != blank %}
      <div class="order-text">
        {{ section.settings.order_text }}
      </div>
      {% endif %}
      <div class="order-images">
        <ul>
          {% for block in section.blocks %}
            {% if block.type == 'order-image' %}
          	  {% if block.settings.order_img != blank %}
              <li class="image">
                <img src="{{ block.settings.order_img | img_url: 'master'}}">
              </li> 
            {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</div>
{% endif %}


{% schema %}
  {
    "name": "Order Section",
    "settings": [
  	  {
        "type": "header",
        "content": "Order text"
      },
      {
        "type": "richtext",
        "id": "order_text",
        "label": "text"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#fff"
      }
    ],
    "blocks": [
      {
        "type": "order-image",
        "name": "Order image",
        "settings": [
          {
            "type": "image_picker",
            "id": "order_img",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "category": "Image",
        "name": "Order Section",
        "settings": {}
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
