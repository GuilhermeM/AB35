        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Font size",
        "default": 30
      },
	  {
        "type": "select",
        "id": "overlay_title_transform",
        "label": "Title Transform",
        "options": [
          {
            "value": "lowercase",
            "label": "Lowercase"
          },
          {
            "value": "capitalize",
            "label": "Capitalize"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ],
      "default": "lowercase"
      },
	  {
        "type": "select",
        "id": "overlay_title_align",
        "label": "Title Align",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
      "default": "center"
      },
	  {
		"type":"header",
		"content":"Button"
	  },
	  {
		"type":"text",
		"id":"overlay_button",
		"label":"Button Heading"
	  },
	  {
        "type":"color",
        "id":"overlay_button_color",
        "label":"Button Color"
      },
	  {
        "type":"color",
        "id":"overlay_button_bgcolor",
        "label":"Button Bg Color"
      },
	  {
        "type":"color",
        "id":"overlay_button_bordercolor",
        "label":"Button Border Color"
      },
	  {
        "type": "range",
        "id": "overlay_button_size",
        "min": 10,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Button Font size",
        "default": 30
      },
	  {
        "type": "select",
        "id": "overlay_button_transform",
        "label": "Button Transform",
        "options": [
          {
            "value": "lowercase",
            "label": "Lowercase"
          },
          {
            "value": "capitalize",
            "label": "Capitalize"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ],
      "default": "lowercase"
      },
	  {
        "type": "select",
        "id": "overlay_button_align",
        "label": "Button Align",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
      "default": "center"
      }
	],
	"presets": [
	  {
		"name":"Image With Text Overlay",
		"category":"Image With Text Overlay"
	  }
	]
  }
{% endschema %}

