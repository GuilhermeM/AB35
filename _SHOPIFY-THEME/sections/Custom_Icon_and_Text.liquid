                {% endif %}
                <div class="Icon_with_text_Details">
                  <div class="Icon_with_text_title">
                    {% if block.settings.svg_title != blank %}
                      <h2>{{block.settings.svg_title}}</h2>
                    {% endif %}
                  </div>
                  <div class="Icon_with_text_subtitle">
                    {% if block.settings.svg_subtitle != blank %}
                     {{block.settings.svg_subtitle}}
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-{{section.id}} .Icon_with_text_main_section .Icon_with_text_main_content {
    background-color: {{section.settings.section_bg_color}};
  }
  
  {% for block in section.blocks %}
    {% if block.settings.block_bg_color != blank %}
      .section-{{section.id}} .Icon_with_text_main_section .Icon_with_text_content_bar .Icon_with_text_content {
        background-color: {{block.settings.block_bg_color}};
      }
    {% endif %}
  {% endfor %}
</style>

{% schema %}
  {
    "name": "Custom Icon With text",
	"max_blocks": 4,
    "settings": [
	  {
		"type":"text",
		"id":"main_title",
		"label":"Heading"
	  },
	  {
		"type":"richtext",
		"id":"main_descriptions",
		"label":"Sub Heading"
	  },
	  {
		"type":"color",
		"id":"section_bg_color",
		"label":"Background Color"
	  },
  	  {
        "type": "checkbox",
        "id": "show_count",
        "label": "Show count",
        "default": false
      },
	  {
        "type": "checkbox",
        "id": "show_rewardcard",
        "label": "Show reward card",
        "default": false
      },
	  {
		"type":"text",
		"id":"discount_coupen_text",
		"label":"Discount Coupen Text"
	  },
	  {
        "type": "select",
        "id": "select_grid",
        "label": "Select Grid",
        "options": [
          {
            "value": "three",
            "label": "Three"
          },
          {
            "value": "four",
            "label": "Four"
          }
        ],
        "default": "three"
      }
	],
	"blocks": [
	  {
		 "type":"Content",
		 "name":"Content",
		 "settings": [
			{
              "type":"color",
              "id":"block_bg_color",
              "label":"Background Color"
            },
			{
			  "type":"text",
			  "id":"svg_title",
			  "label":"Heading"
			},
		    {
			  "type":"richtext",
			  "id":"svg_subtitle",
			  "label":"Sub Heading"
			}
		 ]
	  }
	],
	"presets": [
	  {
		 "name":"Custom Icon With text",
		 "category":"Icon With text"
	  }
	]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
