<div class="product_with_text_info">
  <div class="container">
    <div class="product_text_content align-{{section.settings.text_info_align}}">
      <div class="product_text_left">
        {% if section.settings.title != blank %}
        <h2 class="heading">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.info != blank %}
        {{ section.settings.info }}
        {% endif %}
        {% if section.settings.btn_label != blank %}
        <a class="shop_btn desktop_btn" href="{{ section.settings.btn_url }}">{{ section.settings.btn_label }}</a>
        {% endif %}
      </div>
      <div class="product_right">
        {%- assign collection = collections[section.settings.collection] -%}
        {%- for product in collection.products limit: 4 -%}
        <div class="Carousel__Cell">
          {%- render 'product-item', product: product, show_product_info: section.settings.show_product_info, show_vendor: section.settings.show_vendor, show_color_swatch: section.settings.show_color_swatch, show_labels: true -%}
        </div>
        {%- endfor -%}
      </div>
      {% if section.settings.btn_label != blank %}
      <a class="shop_btn mobile_btn" href="{{ section.settings.btn_url }}">{{ section.settings.btn_label }}</a>
      {% endif %}
    </div>
  </div>
</div>
<style>
  .product_with_text_info .product_text_content.align-right .product_text_left {
    order: 2;
  }
  .product_with_text_info .product_text_content .product_text_left {
    text-align: {{ section.settings.info_align }};
  }
  .product_with_text_info .product_text_content .product_text_left .heading {
    color: {{ section.settings.title_color }};
  }
  .product_with_text_info .product_text_content .product_text_left p {
    color: {{ section.settings.info_color }};
  }
  .product_with_text_info .product_text_content .shop_btn {
    {% if section.settings.btn_label_color != blank %}
  	color: {{ section.settings.btn_label_color }};
    {% endif %}
    {% if section.settings.btn_bg_color != blank %}
    background-color: {{ section.settings.btn_bg_color }};
    border-color: {{ section.settings.btn_bg_color }};
    {% endif %}
  }
  {% if section.settings.product_title_color != blank %}
  .product_with_text_info .product_text_content .product_right .ProductItem__Title a {
    color: {{ section.settings.product_title_color }};
  }
  {% endif %}
  {% if section.settings.product_price_color != blank %}
  .product_with_text_info .product_text_content .product_right .ProductItem__PriceList .money {
    color: {{ section.settings.product_price_color }};
  }
  {% endif %}
  .product_with_text_info .product_text_content .product_right .ProductItem__Info {
    text-align: {{ section.settings.product_info_align }};
  }
</style>
{% schema %}
  {
   "name":"Product With Text Info",
	"class": "product_with_text_section",
   "settings":[
	  {
        "type":"header",
        "content":"Text Info"
      },
      {
         "type":"text",
         "id":"title",
         "label":"Heading"
      },
      {
         "type":"richtext",
         "id":"info",
         "label":"Info"
      },
      {
         "type":"text",
         "id":"btn_label",
         "label":"Button Label"
      },
      {
         "type":"url",
         "id":"btn_url",
         "label":"Button Url"
      },
	  {
        "type": "color",
        "id": "title_color",
        "label": "Heading Color"
      },
	  {
        "type": "color",
        "id": "info_color",
        "label": "Info Color"
      },
	  {
        "type": "color",
        "id": "btn_bg_color",
        "label": "Button Background Color"
      },
	  {
        "type": "color",
        "id": "btn_label_color",
        "label": "Button Label Color"
      },
	  {
          "type": "select",
          "id": "text_info_align",
          "label": "Text Grid Align",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
		{
          "type": "select",
          "id": "info_align",
          "label": "Text Info Align",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
			{
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
      {
        "type":"header",
        "content":"Product Settings"
      },
	  {
          "type": "select",
          "id": "product_info_align",
          "label": "Product Info Align",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
			{
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
		{
        "type": "color",
        "id": "product_title_color",
        "label": "Product Heading Color"
      },
	  {
        "type": "color",
        "id": "product_price_color",
        "label": "Product Price Color"
      },
      {
         "type":"collection",
         "id":"collection",
         "label":"Collection"
      },
      {
         "type":"checkbox",
         "id":"show_product_info",
         "label":"Show product info",
         "default":true
      },
      {
         "type":"checkbox",
         "id":"show_vendor",
         "label":"Show vendor",
         "default":false
      },
      {
         "type":"checkbox",
         "id":"show_color_swatch",
         "label":"Show color swatch",
         "info":"Some colors appear white? [Learn more](http://support.maestrooo.com/article/80-product-uploading-custom-color-for-color-swatch).",
         "default":false
      }
   ],
   "presets":[
      {
         "category":"Product",
         "name":"Product With Text Info"
      }
   ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

