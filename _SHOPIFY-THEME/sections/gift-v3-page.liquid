  {%- comment -%} ========== 5. MOST LOVED PRODUCTS ========== {%- endcomment -%}
  <section class="gv3-products-wrapper">
    <div class="gv3-products-header gv3-fade-up">
      <div class="gv3-products-header-top">
        {%- if section.settings.products_eyebrow != blank -%}
          <div class="gv3-products-eyebrow">{{ section.settings.products_eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.products_title != blank -%}
          <h2 class="gv3-products-title">{{ section.settings.products_title }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.products_desc != blank -%}
        <p class="gv3-products-subtitle">{{ section.settings.products_desc }}</p>
      {%- endif -%}
    </div>
    <div class="gv3-product-shelf">
      {%- assign product_collection = section.settings.products_collection -%}
      {%- assign product_limit = section.settings.products_limit | default: 4 -%}
      {%- if product_collection != blank -%}
        {%- for product in collections[product_collection].products limit: product_limit -%}
          <a href="{{ product.url }}" class="gv3-product-card">
            <div class="gv3-product-img-wrap">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                >
              {%- endif -%}
              {%- if product.metafields.custom.badge != blank -%}
                <div class="gv3-product-badge">{{ product.metafields.custom.badge }}</div>
              {%- elsif product.tags contains 'custom' -%}
                <div class="gv3-product-badge gv3-badge-gold">Make Your Own</div>
              {%- elsif product.tags contains 'Just Restocked"' or product.tags contains 'New Release' -%}
                <div class="gv3-product-badge gv3-badge-green">New Release</div>
              {%- elsif product.tags contains 'Category_Best Sellers' -%}
                <div class="gv3-product-badge">Bestseller</div>
              {%- else -%}
                <div class="gv3-product-badge gv3-badge-green">Most Gifted</div>
              {%- endif -%}
              <svg class="gv3-product-heart" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <div class="gv3-product-name">{{ product.title }}</div>
              <div class="gv3-product-stars">
                {%- assign rating_value = product.metafields.reviews.rating.value.rating | default: 0 | times: 1.0 -%}
                {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
                {%- for i in (1..5) -%}
                  {%- assign prev_star = i | minus: 1 -%}
                  {%- if rating_value >= i -%}
                    <svg class="gv3-star-filled"><use href="#gv3-star"/></svg>
                  {%- elsif rating_value > prev_star -%}
                    <svg class="gv3-star-filled"><use href="#gv3-star"/></svg>
                  {%- else -%}
                    <svg class="gv3-star-empty"><use href="#gv3-star"/></svg>
                  {%- endif -%}
                {%- endfor -%}
                <span class="gv3-review-count">{{ rating_count }} Reviews</span>
              </div>
              <div class="gv3-product-price">
                {%- if product.price_varies -%}
                  From {{ product.price_min | money }}
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="gv3-product-card">
              <div class="gv3-product-img-wrap" style="background:var(--gv3-light-gray);"></div>
              <div class="gv3-product-name">Product Name</div>
              <div class="gv3-product-stars">
                {%- for s in (1..5) -%}
                  <svg class="gv3-star-empty"><use href="#gv3-star"/></svg>
                {%- endfor -%}
                <span class="gv3-review-count">0 Reviews</span>
              </div>
              <div class="gv3-product-price">$0</div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
  </section>

  {%- comment -%} ========== 6+7. UGC — REVIEWS + VIDEO (using theme native components) ========== {%- endcomment -%}
</div>{%- comment -%} Close #gv3 so theme CSS applies to native review components {%- endcomment -%}

<section class="reviews">
  <div class="reviews__inner">
    <div class="Container">
      <div class="reviews__wrapper">
        <div class="reviews__wrap">

          <style>
            .gv3-reviews-title,
            .gv3-reviews-title p,
            .gv3-reviews-title em {
              font-family: 'Instrument Sans', sans-serif !important;
              font-weight: 400 !important;
              font-size: 24px !important;
              line-height: 160% !important;
              letter-spacing: .48px !important;
              text-align: center !important;
              text-transform: capitalize !important;
              color: #1C1B1B !important;
              margin: 0 !important;
              padding: 0 !important;
            }
            .gv3-reviews-title em { font-style: italic !important; color: #9F755B !important; }

            #shopify-section-{{ section.id }} .reviews__btn a {
              display: inline-flex !important;
              justify-content: center !important;
              align-items: center !important;
              padding: 16px 40px !important;
              height: 48px !important;
              background: #C8A983 !important;
              border: none !important;
              border-radius: 0 !important;
              font-family: 'Instrument Sans', sans-serif !important;
              font-weight: 500 !important;
              font-size: 14px !important;
              line-height: 17px !important;
              letter-spacing: 0.1em !important;
              text-transform: uppercase !important;
              color: #1C1B1B !important;
              text-decoration: none !important;
              transition: background 0.25s !important;
            }
            #shopify-section-{{ section.id }} .reviews__btn a:hover {
              background: #b8956f !important;
            }
          </style>
          {%- if section.settings.reviews_headline != blank -%}
            <h2 class="gv3-reviews-title">{{ section.settings.reviews_headline }}</h2>
          {%- endif -%}

          <div class="reviews__star">
            <div>
              <img class="reviews__star-img" src="{{ 'stars.png' | asset_url }}" alt="Star rating" loading="lazy">
              {%- if section.settings.reviews_rating != blank -%}
                <span>{{ section.settings.reviews_rating }}</span>
              {%- endif -%}
            </div>
            {%- if section.settings.reviews_subtitle != blank -%}
              <p class="reviews__subtitle">{{ section.settings.reviews_subtitle }}</p>
            {%- endif -%}
          </div>

          <div class="reviews__items">
            <div class="reviews__list">
              {%- assign review_index = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'review_card' -%}
                  {%- assign pair_index = review_index | modulo: 2 -%}
                  {%- if pair_index == 0 -%}
                    <div class="reviews__item">
                  {%- endif -%}

                  <div class="reviews-card" {{ block.shopify_attributes }}>
                    <div class="reviews-card__Header">
                      {%- if block.settings.reviewer_image != blank -%}
                        <img class="reviews-card__img" src="{{ block.settings.reviewer_image | image_url: width: 500 }}" alt="{{ block.settings.reviewer_name | escape }}" loading="lazy">
                      {%- elsif block.settings.reviewer_image_url != blank -%}
                        <img class="reviews-card__img" src="{{ block.settings.reviewer_image_url }}" alt="{{ block.settings.reviewer_name | escape }}" loading="lazy">
                      {%- endif -%}
                      <div class="reviews-card__Des">
                        {%- if block.settings.review_heading != blank -%}
                          <h4>{{ block.settings.review_heading }}</h4>
                        {%- endif -%}
                        {%- if block.settings.short_text != blank -%}
                          <p data-fullhtml="{{ block.settings.full_text | escape }}" data-expanded="false">
                            {{ block.settings.short_text }}
                            {%- if block.settings.full_text != blank -%}
                              <a href="#" class="reviews-card__readmore">Read more...</a>
                            {%- endif -%}
                          </p>
                        {%- endif -%}
                      </div>
                    </div>

                    <div class="reviews-card__Footer">
                      <div class="reviews-card__buyer">
                        {{ block.settings.reviewer_name }}
                        <span>Verified Buyer</span>
                        <img src="{{ 'verfied.png' | asset_url }}" alt="Verified badge" loading="lazy">
                      </div>
                      <div class="reviews-card__stars">
                        <img src="{{ 'stars.png' | asset_url }}" alt="Star rating" loading="lazy">
                      </div>
                    </div>
                  </div>

                  {%- if pair_index == 1 or forloop.last -%}
                    </div>
                  {%- endif -%}
                  {%- assign review_index = review_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.reviews_btn_text != blank -%}
            <div class="reviews__btn">
              <a href="{{ section.settings.reviews_btn_link | default: '/pages/reviews' }}">{{ section.settings.reviews_btn_text }}</a>
            </div>
          {%- endif -%}

        </div>
      </div>
    </div>
  </div>
</section>

