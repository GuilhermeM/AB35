{%- comment -%} ——— JAVASCRIPT ——— {%- endcomment -%}
<script>
  (function() {
    /* 1. Fade-up on scroll */
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) e.target.classList.add('visible');
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

    document.querySelectorAll('#gv3 .gv3-fade-up').forEach(function(el) {
      observer.observe(el);
    });

    /* 2. Quiz chip logic */
    var chips = document.querySelectorAll('#gv3 .gv3-chip');
    var resultPanel = document.getElementById('gv3-quiz-result');
    var resultContents = document.querySelectorAll('#gv3 .gv3-quiz-result-content');

    function selectChip(chip) {
      chips.forEach(function(c) { c.classList.remove('active'); });
      chip.classList.add('active');

      var index = chip.getAttribute('data-quiz-index');
      resultContents.forEach(function(content) {
        content.style.display = content.getAttribute('data-result-index') === index ? '' : 'none';
      });

      resultPanel.classList.add('visible');
    }

    chips.forEach(function(chip) {
      chip.addEventListener('click', function() { selectChip(this); });
    });

    /* Auto-select first chip */
    if (chips.length > 0) {
      selectChip(chips[0]);
    }

    /* 3. Video play/pause — handled by theme native customar-video JS */

    /* 4. Read more toggle (for native reviews) */
    document.querySelectorAll('.reviews-card__readmore').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var pEl = this.closest('p');
        var fullHtml = pEl.getAttribute('data-fullhtml');
        if (fullHtml && pEl.getAttribute('data-expanded') === 'false') {
          pEl.textContent = fullHtml;
          pEl.setAttribute('data-expanded', 'true');
        }
      });
    });
  })();

</script>

