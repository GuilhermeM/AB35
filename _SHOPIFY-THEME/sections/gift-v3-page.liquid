{% comment %}
  Gift Guide V3 — Nominal
  Full-page section: Hero, Trust Bar, Quiz, Budget, Products, Reviews, Videos, CTA
  All content is editable via Theme Editor (settings + blocks).
  Drop this file into sections/ and use with page.gift-guide-v3.json
{% endcomment %}

{%- comment -%} ——— LCP HERO PRELOAD ——— {%- endcomment -%}
{%- if section.settings.hero_image != blank -%}
  <link rel="preload" as="image" href="{{ section.settings.hero_image | image_url: width: 2000 }}" fetchpriority="high">
{%- else -%}
  <link rel="preload" as="image" href="https://cdn.shopify.com/s/files/1/2556/8900/files/hero-image-compressed-resized.webp?v=1778353921" fetchpriority="high">
{%- endif -%}

{%- comment -%} ——— GOOGLE FONTS ——— {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

{%- comment -%} ——— STYLES ——— {%- endcomment -%}
<style>
  /* ===== SCOPE: all styles under #gv3 to avoid theme conflicts ===== */
  #gv3 {
    --gv3-black: #0a0a0a;
    --gv3-off-white: #f7f5f2;
    --gv3-warm-white: #faf9f7;
    --gv3-mid-gray: #8a8a8a;
    --gv3-light-gray: #e8e6e3;
    --gv3-green: #1a2e1a;
    --gv3-gold: #c9a96e;
    --gv3-tan: #f0ebe3;
    --gv3-serif: 'Cormorant Garamond', Georgia, serif;
    --gv3-sans: 'DM Sans', sans-serif;

    background: var(--gv3-warm-white);
    color: var(--gv3-black);
    font-family: var(--gv3-sans);
    font-weight: 300;
    overflow-x: hidden;
    line-height: 1.5;
  }
  #gv3 *, #gv3 *::before, #gv3 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  #gv3 h1, #gv3 h2, #gv3 h3, #gv3 h4, #gv3 p { margin: 0; padding: 0; font-size: inherit; font-weight: inherit; }
  #gv3 a { text-decoration: none; color: inherit; }
  #gv3 img { max-width: 100%; display: block; }

  /* ===== BUTTONS ===== */
  #gv3 .gv3-btn-primary {
    display: inline-block; background: var(--gv3-off-white); color: var(--gv3-black);
    padding: 14px 36px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    text-decoration: none; transition: background 0.25s, color 0.25s;
    width: fit-content; border: none; cursor: pointer; font-family: var(--gv3-sans);
  }
  #gv3 .gv3-btn-primary:hover { background: var(--gv3-gold); color: #fff; }
  #gv3 .gv3-btn-outline-light {
    display: inline-block; border: 1px solid rgba(255,255,255,0.4); color: #fff;
    padding: 14px 36px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    text-decoration: none; transition: background 0.25s, color 0.25s, border-color 0.25s;
    width: fit-content; background: transparent; cursor: pointer; font-family: var(--gv3-sans);
  }
  #gv3 .gv3-btn-outline-light:hover { background: #fff; color: var(--gv3-black); border-color: #fff; }
  #gv3 .gv3-btn-outline {
    display: inline-block; border: 1px solid var(--gv3-black); color: var(--gv3-black);
    padding: 14px 36px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    text-decoration: none; transition: background 0.25s, color 0.25s;
    width: fit-content; background: transparent; cursor: pointer; font-family: var(--gv3-sans);
  }
  #gv3 .gv3-btn-outline:hover { background: var(--gv3-black); color: #fff; }
  #gv3 .gv3-btn-dark {
    display: inline-block; background: var(--gv3-black); color: #fff;
    padding: 14px 36px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    text-decoration: none; transition: background 0.25s, color 0.25s;
    width: fit-content; border: none; cursor: pointer; font-family: var(--gv3-sans);
  }
  #gv3 .gv3-btn-dark:hover { background: var(--gv3-gold); }

  /* ===== SECTION HEADER (reusable) ===== */
  #gv3 .gv3-section-header { text-align: center; padding: 80px 48px 48px; }
  #gv3 .gv3-section-eyebrow {
    font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--gv3-mid-gray); margin-bottom: 16px;
  }
  #gv3 .gv3-section-title {
    font-family: var(--gv3-serif); font-size: clamp(36px, 4vw, 56px);
    font-weight: 300; line-height: 1.1;
  }
  #gv3 .gv3-section-title em { font-style: italic; }
  #gv3 .gv3-section-desc {
    font-size: 14px; line-height: 1.75; color: var(--gv3-mid-gray);
    max-width: 480px; margin: 16px auto 0;
  }

  /* ===== 1. HERO ===== */
  #gv3 .gv3-hero {
    position: relative;
    display: flex; flex-direction: column;
    justify-content: flex-end; align-items: flex-start;
    padding: 120px 64px 64px;
    height: 500px;
    overflow: hidden;
  }
  #gv3 .gv3-hero-bg-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center top; z-index: 0;
  }
  #gv3 .gv3-hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: rgba(28, 27, 27, 0.6);
  }
  #gv3 .gv3-hero-inner {
    position: relative; z-index: 2;
    width: 100%;
  }
  #gv3 .gv3-hero-content {
    display: flex; flex-direction: column;
    justify-content: flex-end; align-items: flex-start;
    gap: 48px;
    max-width: 500px;
  }
  #gv3 .gv3-hero-text {
    display: flex; flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  #gv3 .gv3-hero-eyebrow {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-size: 14px; font-weight: 400;
    line-height: 120%; text-transform: uppercase;
    color: #fff;
  }
  #gv3 .gv3-hero-title,
  #gv3 .gv3-hero-title p {
    font-family: var(--gv3-serif) !important;
    font-size: clamp(52px, 5.5vw, 80px) !important; font-weight: 500 !important;
    line-height: 100% !important; color: #fff;
    margin: 0; padding: 0;
  }
  #gv3 .gv3-hero-title em { font-style: italic; color: var(--gv3-gold); }
  #gv3 .gv3-hero-sub {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-size: 16px; font-weight: 400;
    line-height: 160%; letter-spacing: 0.04em;
    color: #fff;
  }
  #gv3 .gv3-hero-btns {
    display: flex; flex-direction: row; align-items: flex-start;
    gap: 12px; width: 100%;
  }
  #gv3 .gv3-hero-btns a {
    flex: 1; display: flex; justify-content: center; align-items: center;
    padding: 16px 40px; height: 48px;
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-size: 14px; font-weight: 500;
    line-height: 17px; letter-spacing: 0.1em;
    text-transform: uppercase; text-decoration: none;
    white-space: nowrap;
    cursor: pointer; transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  #gv3 .gv3-hero-btns .gv3-btn-primary {
    background: #C8A983; color: #1C1B1B; border: none;
    width: auto; padding: 16px 40px;
  }
  #gv3 .gv3-hero-btns .gv3-btn-primary:hover { background: #b8956f; }
  #gv3 .gv3-hero-btns .gv3-btn-outline-light {
    background: transparent; color: #fff;
    border: 1px solid #fff; width: auto; padding: 16px 40px;
  }
  #gv3 .gv3-hero-btns .gv3-btn-outline-light:hover { background: #fff; color: #1C1B1B; }

  /* ===== 2. TRUST BAR / MARQUEE ===== */
  #gv3 .gv3-trust-bar {
    background: var(--gv3-black); padding: 12px 48px;
    overflow: hidden; white-space: nowrap; position: relative;
    height: 48px; display: flex; align-items: center;
  }
  #gv3 .gv3-trust-bar::before,
  #gv3 .gv3-trust-bar::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: 60px; z-index: 2; pointer-events: none;
  }
  #gv3 .gv3-trust-bar::before { left: 0; background: linear-gradient(to right, var(--gv3-black), transparent); }
  #gv3 .gv3-trust-bar::after { right: 0; background: linear-gradient(to left, var(--gv3-black), transparent); }
  #gv3 .gv3-marquee-track {
    display: inline-flex; gap: 80px; align-items: center;
    animation: gv3Marquee 30s linear infinite;
  }
  #gv3 .gv3-trust-item {
    display: inline-flex; align-items: center; gap: 10px; flex-shrink: 0;
  }
  #gv3 .gv3-trust-item img { width: 24px; max-width: 24px; height: 24px; object-fit: contain; }
  #gv3 .gv3-trust-item span {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 400; font-size: 14px; line-height: 120%;
    text-transform: uppercase; color: #fff;
  }
  #gv3 .gv3-marquee-dot { color: var(--gv3-gold); font-size: 10px; flex-shrink: 0; }
  @keyframes gv3Marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ===== 3. QUIZ ===== */
  #gv3 .gv3-quiz-section {
    background: #F1EFEA;
  }
  #gv3 .gv3-quiz-inner {
    display: flex; flex-direction: column; align-items: center;
    padding: 80px 64px; gap: 32px;
    max-width: 1440px; margin: 0 auto;
  }
  #gv3 .gv3-quiz-left {
    display: flex; flex-direction: column; align-items: center;
    gap: 32px; width: 100%;
  }
  #gv3 .gv3-quiz-text-group {
    display: flex; flex-direction: column; align-items: center;
    gap: 16px;
  }
  #gv3 .gv3-quiz-title-group {
    display: flex; flex-direction: column; align-items: center;
    gap: 8px;
  }
  #gv3 .gv3-quiz-eyebrow {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 400; font-size: 14px; line-height: 120%;
    text-transform: uppercase; color: #9F755B;
  }
  #gv3 .gv3-quiz-title {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 400; font-size: 24px; line-height: 140%;
    letter-spacing: 0.02em; text-transform: capitalize;
    color: #1C1B1B;
  }
  #gv3 .gv3-quiz-desc {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 400; font-size: 16px; line-height: 160%;
    letter-spacing: 0.04em; color: #666666;
  }
  #gv3 .gv3-quiz-chips {
    display: flex; flex-direction: row; flex-wrap: wrap;
    justify-content: center; align-items: center; align-content: center;
    gap: 8px; width: 100%;
  }
  #gv3 .gv3-chip {
    display: flex; justify-content: center; align-items: center;
    padding: 10px 20px; min-width: 171px; background: #FFFFFF; border-radius: 4px;
    border: none; cursor: pointer; transition: background 0.2s, color 0.2s;
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 400; font-size: 12px; line-height: 120%;
    text-transform: uppercase; color: #1C1B1B;
    white-space: nowrap;
  }
  #gv3 .gv3-chip:hover { background: #e8dfd3; }
  #gv3 .gv3-chip.active { background: #C8A983; color: #1C1B1B; }
  #gv3 .gv3-quiz-right { flex-shrink: 0; width: 100%; display: flex; justify-content: center; }
  #gv3 .gv3-quiz-result-panel {
    box-sizing: border-box;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    padding: 24px; gap: 24px;
    width: 800px; max-width: 100%;
    background: #FFFFFF; border: 1px solid rgba(0, 0, 0, 0.1); border-radius: 4px;
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  #gv3 .gv3-quiz-result-panel.visible { opacity: 1; transform: translateY(0); }
  #gv3 .gv3-quiz-result-content {
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    gap: 24px; width: 100%;
  }
  #gv3 .gv3-result-header {
    display: flex; flex-direction: column; align-items: center;
    gap: 8px;
  }
  #gv3 .gv3-result-label {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 400; font-size: 14px; line-height: 120%;
    text-transform: uppercase; color: #9F755B;
  }
  #gv3 .gv3-result-title {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 400; font-size: 24px; line-height: 140%;
    letter-spacing: 0.02em; text-transform: capitalize;
    color: #1C1B1B; text-align: center;
  }
  #gv3 .gv3-result-images {
    display: flex; flex-direction: row; align-items: flex-start;
    gap: 8px; width: 100%;
  }
  #gv3 .gv3-result-product-card {
    display: flex; flex-direction: column; align-items: center;
    gap: 12px; text-decoration: none; flex: 1;
    transition: opacity 0.2s; position: relative; isolation: isolate;
  }
  #gv3 .gv3-result-product-card:hover { opacity: 0.8; }
  #gv3 .gv3-result-product-info {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
  }
  #gv3 .gv3-result-product-name {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 14px !important; line-height: 23px !important;
    letter-spacing: 0.5px !important; text-align: center !important;
    text-transform: capitalize !important;
    color: #1C1B1B !important; text-decoration: none !important;
    word-wrap: break-word;
  }
  #gv3 .gv3-result-product-price {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 400; font-size: 12px; line-height: 120%;
    text-transform: uppercase; color: #9F755B; text-align: center;
  }
  #gv3 .gv3-result-img {
    width: 100%; aspect-ratio: 7/8;
    object-fit: cover; transition: opacity 0.3s ease;
    background: #FBF4EC;
  }
  #gv3 .gv3-result-wishlist {
    position: absolute; top: 0; right: 0; z-index: 2;
    display: flex; justify-content: center; align-items: center;
    padding: 8px; width: 33px; height: 33px;
    background: none; border: none; cursor: pointer;
  }
  #gv3 .gv3-result-wishlist svg {
    width: 17px; height: 17px; fill: none; stroke: #000; stroke-width: 1.5;
  }
  #gv3 .gv3-result-desc,
  #gv3 .gv3-result-desc p,
  #gv3 .gv3-result-desc span {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 16px !important; line-height: 160% !important;
    letter-spacing: 0.04em !important; text-align: center !important;
    color: #666666 !important;
    text-decoration: none !important;
    margin: 0; padding: 0;
  }
  #gv3 .gv3-result-desc a {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 600 !important; font-size: 16px !important; line-height: 160% !important;
    letter-spacing: 0.04em !important;
    color: #C8A983 !important;
    text-decoration: underline !important;
  }
  #gv3 .gv3-result-desc { align-self: stretch; }
  #gv3 .gv3-quiz-cta {
    display: flex; justify-content: center; align-items: center;
    padding: 16px 40px; height: 48px;
    background: #C8A983; border: none; border-radius: 0;
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 500; font-size: 14px; line-height: 17px;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #1C1B1B; text-decoration: none; cursor: pointer;
    align-self: stretch; transition: background 0.25s;
  }
  #gv3 .gv3-quiz-cta:hover { background: #b8956f; }

  /* ===== REVIEWS BAR ===== */
  #gv3 .gv3-reviews-bar {
    display: flex; justify-content: center; align-items: center;
    padding: 14px 48px; gap: 12px;
    background: #1C1B1B; width: 100%;
  }
  #gv3 .gv3-reviews-bar-stars {
    display: flex; gap: 2px;
  }
  #gv3 .gv3-reviews-bar-stars svg {
    width: 16px; height: 16px; fill: #C8A983;
  }
  #gv3 .gv3-reviews-bar-text {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 500; font-size: 14px; line-height: 17px;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #FFFFFF;
  }

  /* ===== COLLECTIONS GRID ===== */
  #gv3 .gv3-collections-section {
    display: flex; flex-direction: column; align-items: center;
    padding: 80px 64px; gap: 48px;
    background: #FFFFFF;
  }
  #gv3 .gv3-collections-title {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 400; font-size: 32px; line-height: 140%;
    letter-spacing: 0.02em; text-transform: capitalize;
    color: #0A0A0A; text-align: center;
  }
  #gv3 .gv3-collections-title p { margin: 0; padding: 0; }
  #gv3 .gv3-collections-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 16px; width: 100%; max-width: 1312px;
  }
  #gv3 .gv3-collection-card {
    position: relative; overflow: hidden;
    aspect-ratio: 3/4; display: flex;
    flex-direction: column; justify-content: flex-end;
    text-decoration: none; color: #fff;
  }
  #gv3 .gv3-collection-card-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; z-index: 0;
    transition: transform 0.4s ease;
  }
  #gv3 .gv3-collection-card:hover .gv3-collection-card-bg {
    transform: scale(1.05);
  }
  #gv3 .gv3-collection-card-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(0deg, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0) 60%);
  }
  #gv3 .gv3-collection-card-content {
    position: relative; z-index: 2;
    padding: 24px; display: flex;
    flex-direction: column; gap: 8px;
  }
  #gv3 .gv3-collection-card-title {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 400; font-size: 20px; line-height: 140%;
    letter-spacing: 0.02em; color: #fff;
  }
  #gv3 .gv3-collection-card-cta {
    font-family: 'Instrument Sans', var(--gv3-sans);
    font-weight: 500; font-size: 12px; line-height: 120%;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #C8A983;
  }
  @media (max-width: 1024px) {
    #gv3 .gv3-collections-grid { grid-template-columns: repeat(2, 1fr); }
    #gv3 .gv3-collections-section { padding: 60px 48px; }
  }
  @media (max-width: 640px) {
    #gv3 .gv3-collections-grid { grid-template-columns: 1fr; }
    #gv3 .gv3-collections-section { padding: 48px 24px; gap: 32px; }
    #gv3 .gv3-collections-title { font-size: 28px; }
    #gv3 .gv3-reviews-bar { padding: 12px 16px; }
    #gv3 .gv3-reviews-bar-text { font-size: 12px; }
  }

  /* ===== 4. SHOP BY BUDGET ===== */
  #gv3 .gv3-budget-wrapper {
    display: flex; flex-direction: column; align-items: center;
    padding: 80px 64px; gap: 48px;
    background: #F1EFEA;
  }
  #gv3 .gv3-budget-header {
    display: flex; flex-direction: column; align-items: center;
    gap: 16px;
  }
  #gv3 .gv3-budget-header-top {
    display: flex; flex-direction: column; align-items: center;
    gap: 8px;
  }
  #gv3 .gv3-budget-eyebrow {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 14px !important; line-height: 120% !important;
    text-transform: uppercase; color: #9F755B !important;
  }
  #gv3 .gv3-budget-title,
  #gv3 .gv3-budget-title p {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 32px !important; line-height: 140% !important;
    letter-spacing: 0.02em !important; text-transform: capitalize;
    color: #0A0A0A !important; text-align: center;
    margin: 0 !important; padding: 0 !important;
  }
  #gv3 .gv3-budget-title em { font-style: italic; color: #9F755B !important; }
  #gv3 .gv3-budget-subtitle {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 16px !important; line-height: 160% !important;
    letter-spacing: 0.04em; color: #666666 !important; text-align: center;
  }
  #gv3 .gv3-budget-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
    width: 100%;
  }
  #gv3 .gv3-budget-card {
    position: relative; overflow: hidden; cursor: pointer;
    text-decoration: none; display: flex;
    flex-direction: row; align-items: flex-end;
    padding: 24px; height: 432px;
    background: var(--gv3-black);
    transition: opacity 0.3s;
  }
  #gv3 .gv3-budget-card:hover { opacity: 0.9; }
  #gv3 .gv3-budget-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center top;
  }
  #gv3 .gv3-budget-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(28, 27, 27, 0.5), rgba(28, 27, 27, 0.5));
  }
  #gv3 .gv3-budget-content {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 24px; flex: 1;
  }
  #gv3 .gv3-budget-text {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 8px; align-self: stretch;
  }
  #gv3 .gv3-budget-label {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 14px !important; line-height: 120% !important;
    text-transform: uppercase; color: #FFFFFF !important;
  }
  #gv3 .gv3-budget-range {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 32px !important; line-height: 140% !important;
    letter-spacing: 0.02em; text-transform: capitalize;
    color: #FFFFFF !important;
  }
  #gv3 .gv3-budget-desc {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 16px !important; line-height: 160% !important;
    letter-spacing: 0.04em; color: #FFFFFF !important;
    align-self: stretch;
  }
  #gv3 .gv3-budget-link {
    display: flex; flex-direction: row; align-items: center;
    padding: 8px 0; gap: 8px; align-self: stretch;
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 500 !important; font-size: 14px !important; line-height: 17px !important;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #FFFFFF !important; text-decoration: none !important;
  }

  /* ===== 5. PRODUCTS ===== */
  #gv3 .gv3-products-wrapper {
    display: flex; flex-direction: column; align-items: flex-start;
    padding: 80px 64px; gap: 48px;
    background: #FFFFFF;
  }
  #gv3 .gv3-products-header {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 16px;
  }
  #gv3 .gv3-products-header-top {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 8px;
  }
  #gv3 .gv3-products-eyebrow {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 14px !important; line-height: 120% !important;
    text-transform: uppercase; color: #9F755B !important;
  }
  #gv3 .gv3-products-title,
  #gv3 .gv3-products-title p {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 32px !important; line-height: 140% !important;
    letter-spacing: 0.02em !important; text-transform: capitalize;
    color: #0A0A0A !important; margin: 0 !important; padding: 0 !important;
  }
  #gv3 .gv3-products-title em { font-style: italic; color: #9F755B !important; }
  #gv3 .gv3-products-subtitle {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 16px !important; line-height: 160% !important;
    letter-spacing: 0.04em; color: #666666 !important;
    max-width: 504px;
  }
  #gv3 .gv3-product-shelf {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
    width: 100%;
  }
  #gv3 .gv3-product-card {
    display: flex; flex-direction: column; cursor: pointer;
    text-decoration: none; color: inherit;
  }
  #gv3 .gv3-product-img-wrap {
    aspect-ratio: 1/1; background: #FBF4EC;
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden; margin-bottom: 16px;
  }
  #gv3 .gv3-product-img-wrap img {
    width: 100%; height: 100%; object-fit: contain;
    transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  #gv3 .gv3-product-card:hover .gv3-product-img-wrap img { transform: scale(1.05); }
  #gv3 .gv3-product-badge {
    position: absolute; top: 10px; left: 10px;
    background: #1C1B1B; color: #fff; opacity: 0.9;
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-size: 14px !important; font-weight: 400 !important;
    line-height: 23px; padding: 2px 8px;
  }
  #gv3 .gv3-badge-gold { background: #C8A983; color: #1C1B1B; }
  #gv3 .gv3-badge-green { background: #1A2E1A; color: #fff; }
  #gv3 .gv3-product-heart {
    position: absolute; top: 12px; right: 12px;
    width: 24px; height: 24px; cursor: pointer;
    fill: none; stroke: #1C1B1B; stroke-width: 1.5;
    transition: fill 0.2s;
  }
  #gv3 .gv3-product-heart:hover { fill: #1C1B1B; }
  #gv3 .gv3-product-type {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-size: 12px !important; letter-spacing: 0.06em !important; text-transform: uppercase;
    color: #9F755B !important; margin-bottom: 4px;
  }
  #gv3 .gv3-product-name {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-size: 16px !important; font-weight: 400 !important;
    color: #1C1B1B !important; margin-bottom: 12px; line-height: 140% !important;
  }
  #gv3 .gv3-product-stars {
    display: flex; align-items: center; gap: 6px; margin-bottom: 8px;
    flex-wrap: nowrap;
  }
  #gv3 .gv3-product-stars svg { width: 16px; height: 16px; flex-shrink: 0; }
  #gv3 .gv3-product-stars .gv3-star-filled { fill: #C8A983; }
  #gv3 .gv3-product-stars .gv3-star-empty { fill: var(--gv3-light-gray); }
  #gv3 .gv3-product-stars .gv3-review-count {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-size: 14px !important; color: #666666 !important;
    white-space: nowrap;
  }
  #gv3 .gv3-product-price {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-size: 16px !important; font-weight: 500 !important; color: #1C1B1B !important;
  }

  /* ===== 6+7: Reviews & Videos use theme native CSS (outside #gv3) ===== */

  /* ===== 8. FOOTER CTA ===== */
  #gv3 .gv3-footer-cta {
    display: flex; flex-direction: row; justify-content: center;
    align-items: center; padding: 48px 20px; gap: 80px;
    background: #FFFFFF;
  }
  #gv3 .gv3-cta-image {
    width: 500px; height: 500px; flex-shrink: 0;
    object-fit: cover;
  }
  #gv3 .gv3-cta-right {
    display: flex; flex-direction: column; justify-content: center;
    align-items: flex-start; gap: 32px; max-width: 400px;
  }
  #gv3 .gv3-cta-title,
  #gv3 .gv3-cta-title p {
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 400 !important; font-size: 24px !important;
    line-height: 160% !important; letter-spacing: 0.02em !important;
    text-transform: capitalize;
    color: #1C1B1B !important; margin: 0 !important; padding: 0 !important;
  }
  #gv3 .gv3-cta-btns {
    display: flex; flex-direction: column; justify-content: center;
    align-items: center; gap: 16px; width: 100%;
  }
  #gv3 .gv3-cta-btns a {
    display: flex; justify-content: center; align-items: center;
    padding: 16px 40px; width: 400px; max-width: 100%; height: 48px;
    font-family: 'Instrument Sans', var(--gv3-sans) !important;
    font-weight: 500 !important; font-size: 14px !important; line-height: 17px !important;
    letter-spacing: 0.1em !important; text-transform: uppercase;
    text-decoration: none; cursor: pointer;
    transition: background 0.25s, color 0.25s;
  }
  #gv3 .gv3-cta-btns .gv3-cta-btn-primary {
    background: #C8A983; color: #1C1B1B !important; border: none;
  }
  #gv3 .gv3-cta-btns .gv3-cta-btn-primary:hover { background: #b8956f; }

  /* ===== ANIMATIONS ===== */
  #gv3 .gv3-fade-up {
    opacity: 0; transform: translateY(32px);
    transition: opacity 0.7s cubic-bezier(0.25,0.46,0.45,0.94),
                transform 0.7s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  #gv3 .gv3-fade-up.visible { opacity: 1; transform: translateY(0); }

  /* ===== RESPONSIVE: TABLET ===== */
  @media (max-width: 1024px) {
    #gv3 .gv3-quiz-inner { padding: 60px 48px; }
    #gv3 .gv3-quiz-right { width: 100%; }
    #gv3 .gv3-quiz-result-panel { width: 100%; max-width: 500px; margin: 0 auto; }
    #gv3 .gv3-product-shelf { grid-template-columns: repeat(2, 1fr); }
  }

  /* ===== RESPONSIVE: MOBILE ===== */
  @media (max-width: 640px) {
    #gv3 .gv3-hero { padding: 120px 24px 40px; height: auto; min-height: 500px; }
    #gv3 .gv3-hero-content { max-width: 100%; }
    #gv3 .gv3-hero-btns { flex-direction: column; }
    #gv3 .gv3-hero-btns a { text-align: center; flex: none; width: 100%; }
    #gv3 .gv3-quiz-inner { padding: 48px 24px; gap: 32px; }
    #gv3 .gv3-quiz-result-panel { padding: 20px; width: 100%; }
    #gv3 .gv3-result-images { gap: 12px; }
    #gv3 .gv3-result-img { width: 90px; height: 90px; }
    #gv3 .gv3-quiz-cta { padding: 14px 24px; }
    #gv3 .gv3-budget-wrapper { padding: 48px 24px; gap: 32px; }
    #gv3 .gv3-budget-grid { grid-template-columns: 1fr; }
    #gv3 .gv3-budget-card { height: 360px; }
    #gv3 .gv3-products-wrapper { padding: 48px 24px; gap: 32px; }
    #gv3 .gv3-product-shelf { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    #gv3 .gv3-product-stars { gap: 4px; }
    #gv3 .gv3-product-stars svg { width: 12px; height: 12px; }
    #gv3 .gv3-product-stars .gv3-review-count { font-size: 12px !important; }
    #gv3 .gv3-footer-cta { flex-direction: column; padding: 48px 24px; gap: 40px; }
    #gv3 .gv3-cta-image { width: 100%; height: auto; aspect-ratio: 1/1; }
    #gv3 .gv3-cta-right { max-width: 100%; align-items: center; text-align: center; }
    #gv3 .gv3-cta-btns a { width: 100%; }
    #gv3 .gv3-section-header { padding: 60px 24px 36px; }
  }

  /* ===== PERFORMANCE: defer offscreen render until in-viewport ===== */
  /* Below-the-fold sections — browser skips layout/paint work until scrolled near. */
  /* Browsers without support (Safari <18) ignore the rule — graceful degradation. */
  .gv3-collections-section,
  .gv3-budget-wrapper,
  .gv3-products-wrapper,
  .gv3-footer-cta,
  #shopify-section-{{ section.id }} .customar-video,
  #shopify-section-{{ section.id }} .reviews {
    content-visibility: auto;
    contain-intrinsic-size: 0 800px;
  }
</style>

{%- comment -%} ——— SVG DEFS (star icons) ——— {%- endcomment -%}
<svg xmlns="http://www.w3.org/2000/svg" style="display:none;">
  <symbol id="gv3-star" viewBox="0 0 24 24">
    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
  </symbol>
</svg>

<div id="gv3">

  {%- comment -%} ========== 1. HERO ========== {%- endcomment -%}
  <section class="gv3-hero">
    {%- if section.settings.hero_image != blank -%}
      <img
        src="{{ section.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ section.settings.hero_title | strip_html | escape }}"
        class="gv3-hero-bg-img"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <img
        src="https://cdn.shopify.com/s/files/1/2556/8900/files/hero-image-compressed-resized.webp?v=1778353921"
        alt="{{ section.settings.hero_title | strip_html | escape }}"
        class="gv3-hero-bg-img"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    <div class="gv3-hero-overlay"></div>
    <div class="gv3-hero-inner">
      <div class="gv3-hero-content gv3-fade-up">
        <div class="gv3-hero-text">
          {%- if section.settings.hero_eyebrow != blank -%}
            <div class="gv3-hero-eyebrow">{{ section.settings.hero_eyebrow }}</div>
          {%- endif -%}
          {%- if section.settings.hero_title != blank -%}
            <h1 class="gv3-hero-title">{{ section.settings.hero_title }}</h1>
          {%- endif -%}
          {%- if section.settings.hero_subtitle != blank -%}
            <p class="gv3-hero-sub">{{ section.settings.hero_subtitle }}</p>
          {%- endif -%}
        </div>
        <div class="gv3-hero-btns">
          {%- if section.settings.hero_btn1_text != blank -%}
            <a href="{{ section.settings.hero_btn1_link }}" class="gv3-btn-primary">
              {{ section.settings.hero_btn1_text }}
            </a>
          {%- endif -%}
          {%- if section.settings.hero_btn2_text != blank -%}
            <a href="{{ section.settings.hero_btn2_link }}" class="gv3-btn-outline-light">
              {{ section.settings.hero_btn2_text }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ========== 2. TRUST BAR / MARQUEE ========== {%- endcomment -%}
  <div class="gv3-trust-bar">
    <div class="gv3-marquee-track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          <div class="gv3-trust-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <img src="{{ block.settings.icon | image_url: width: 40 }}" alt="" loading="lazy">
            {%- elsif block.settings.icon_url != blank -%}
              <img src="{{ block.settings.icon_url }}" alt="" width="40" height="40" loading="lazy">
            {%- endif -%}
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          <div class="gv3-trust-item">
            {%- if block.settings.icon != blank -%}
              <img src="{{ block.settings.icon | image_url: width: 40 }}" alt="" loading="lazy">
            {%- elsif block.settings.icon_url != blank -%}
              <img src="{{ block.settings.icon_url }}" alt="" width="40" height="40" loading="lazy">
            {%- endif -%}
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ========== 3. QUIZ ========== {%- endcomment -%}
  <section class="gv3-quiz-section">
    <div class="gv3-quiz-inner">
      <div class="gv3-quiz-left gv3-fade-up">
        <div class="gv3-quiz-text-group">
          <div class="gv3-quiz-title-group">
            {%- if section.settings.quiz_eyebrow != blank -%}
              <div class="gv3-quiz-eyebrow">{{ section.settings.quiz_eyebrow }}</div>
            {%- endif -%}
            {%- if section.settings.quiz_title != blank -%}
              <h2 class="gv3-quiz-title">{{ section.settings.quiz_title }}</h2>
            {%- endif -%}
          </div>
          {%- if section.settings.quiz_desc != blank -%}
            <p class="gv3-quiz-desc">{{ section.settings.quiz_desc }}</p>
          {%- endif -%}
        </div>
        <div class="gv3-quiz-chips">
          {%- assign quiz_chip_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'quiz_chip' -%}
              <button class="gv3-chip" data-quiz-index="{{ quiz_chip_index }}" {{ block.shopify_attributes }}>
                {{ block.settings.chip_label }}
              </button>
              {%- assign quiz_chip_index = quiz_chip_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="gv3-quiz-right">
        <div class="gv3-quiz-result-panel" id="gv3-quiz-result">
          {%- assign quiz_result_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'quiz_chip' -%}
              <div class="gv3-quiz-result-content" data-result-index="{{ quiz_result_index }}"{% unless quiz_result_index == 0 %} style="display:none;"{% endunless %}>
                <div class="gv3-result-header">
                  <div class="gv3-result-label">{{ block.settings.result_title }}</div>
                </div>
                <div class="gv3-result-images">
                  {%- if block.settings.result_product_1 != blank -%}
                    <a href="{{ block.settings.result_product_1.url }}" class="gv3-result-product-card">
                      <img class="gv3-result-img" src="{{ block.settings.result_product_1.featured_image | image_url: width: 500 }}" alt="{{ block.settings.result_product_1.title | escape }}" loading="lazy">
                      <button class="gv3-result-wishlist" aria-label="Add to wishlist"><svg viewBox="0 0 17 17"><path d="M8.5 14.5L2.1 8.3C0.6 6.8 0.6 4.3 2.1 2.8C3.6 1.3 6.1 1.3 7.6 2.8L8.5 3.7L9.4 2.8C10.9 1.3 13.4 1.3 14.9 2.8C16.4 4.3 16.4 6.8 14.9 8.3L8.5 14.5Z"/></svg></button>
                      <div class="gv3-result-product-info">
                        <span class="gv3-result-product-name">{{ block.settings.result_product_1.title }}</span>
                        <span class="gv3-result-product-price">
                          {%- if block.settings.result_product_1.price_varies -%}From {{ block.settings.result_product_1.price_min | money }}{%- else -%}{{ block.settings.result_product_1.price | money }}{%- endif -%}
                        </span>
                      </div>
                    </a>
                  {%- endif -%}
                  {%- if block.settings.result_product_2 != blank -%}
                    <a href="{{ block.settings.result_product_2.url }}" class="gv3-result-product-card">
                      <img class="gv3-result-img" src="{{ block.settings.result_product_2.featured_image | image_url: width: 500 }}" alt="{{ block.settings.result_product_2.title | escape }}" loading="lazy">
                      <button class="gv3-result-wishlist" aria-label="Add to wishlist"><svg viewBox="0 0 17 17"><path d="M8.5 14.5L2.1 8.3C0.6 6.8 0.6 4.3 2.1 2.8C3.6 1.3 6.1 1.3 7.6 2.8L8.5 3.7L9.4 2.8C10.9 1.3 13.4 1.3 14.9 2.8C16.4 4.3 16.4 6.8 14.9 8.3L8.5 14.5Z"/></svg></button>
                      <div class="gv3-result-product-info">
                        <span class="gv3-result-product-name">{{ block.settings.result_product_2.title }}</span>
                        <span class="gv3-result-product-price">
                          {%- if block.settings.result_product_2.price_varies -%}From {{ block.settings.result_product_2.price_min | money }}{%- else -%}{{ block.settings.result_product_2.price | money }}{%- endif -%}
                        </span>
                      </div>
                    </a>
                  {%- endif -%}
                  {%- if block.settings.result_product_3 != blank -%}
                    <a href="{{ block.settings.result_product_3.url }}" class="gv3-result-product-card">
                      <img class="gv3-result-img" src="{{ block.settings.result_product_3.featured_image | image_url: width: 500 }}" alt="{{ block.settings.result_product_3.title | escape }}" loading="lazy">
                      <button class="gv3-result-wishlist" aria-label="Add to wishlist"><svg viewBox="0 0 17 17"><path d="M8.5 14.5L2.1 8.3C0.6 6.8 0.6 4.3 2.1 2.8C3.6 1.3 6.1 1.3 7.6 2.8L8.5 3.7L9.4 2.8C10.9 1.3 13.4 1.3 14.9 2.8C16.4 4.3 16.4 6.8 14.9 8.3L8.5 14.5Z"/></svg></button>
                      <div class="gv3-result-product-info">
                        <span class="gv3-result-product-name">{{ block.settings.result_product_3.title }}</span>
                        <span class="gv3-result-product-price">
                          {%- if block.settings.result_product_3.price_varies -%}From {{ block.settings.result_product_3.price_min | money }}{%- else -%}{{ block.settings.result_product_3.price | money }}{%- endif -%}
                        </span>
                      </div>
                    </a>
                  {%- endif -%}
                </div>
                <a href="{{ block.settings.result_link }}" class="gv3-quiz-cta">{{ block.settings.result_btn_text | default: 'Shop All Gifts' }}</a>
              </div>
              {%- assign quiz_result_index = quiz_result_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ========== REVIEWS BAR ========== {%- endcomment -%}
  <div class="gv3-reviews-bar">
    <div class="gv3-reviews-bar-stars">
      <svg viewBox="0 0 16 16"><polygon points="8,0 10.5,5.1 16,5.9 12,9.8 12.9,15.3 8,12.7 3.1,15.3 4,9.8 0,5.9 5.5,5.1"/></svg>
      <svg viewBox="0 0 16 16"><polygon points="8,0 10.5,5.1 16,5.9 12,9.8 12.9,15.3 8,12.7 3.1,15.3 4,9.8 0,5.9 5.5,5.1"/></svg>
      <svg viewBox="0 0 16 16"><polygon points="8,0 10.5,5.1 16,5.9 12,9.8 12.9,15.3 8,12.7 3.1,15.3 4,9.8 0,5.9 5.5,5.1"/></svg>
      <svg viewBox="0 0 16 16"><polygon points="8,0 10.5,5.1 16,5.9 12,9.8 12.9,15.3 8,12.7 3.1,15.3 4,9.8 0,5.9 5.5,5.1"/></svg>
      <svg viewBox="0 0 16 16"><polygon points="8,0 10.5,5.1 16,5.9 12,9.8 12.9,15.3 8,12.7 3.1,15.3 4,9.8 0,5.9 5.5,5.1"/></svg>
    </div>
    <span class="gv3-reviews-bar-text">{{ section.settings.reviews_bar_text | default: '25,000+ 5-STAR REVIEWS' }}</span>
  </div>

  {%- comment -%} ========== COLLECTIONS GRID ========== {%- endcomment -%}
