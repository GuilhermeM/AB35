  {%- comment -%} ========== 4. SHOP BY BUDGET ========== {%- endcomment -%}
  <section class="gv3-budget-wrapper">
    <div class="gv3-budget-header gv3-fade-up">
      <div class="gv3-budget-header-top">
        {%- if section.settings.budget_eyebrow != blank -%}
          <div class="gv3-budget-eyebrow">{{ section.settings.budget_eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.budget_title != blank -%}
          <h2 class="gv3-budget-title">{{ section.settings.budget_title }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.budget_desc != blank -%}
        <p class="gv3-budget-subtitle">{{ section.settings.budget_desc }}</p>
      {%- endif -%}
    </div>
    <div class="gv3-budget-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'price_card' -%}
          <a href="{{ block.settings.link }}" class="gv3-budget-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.price_range | escape }}"
                class="gv3-budget-bg"
                loading="lazy"
              >
            {%- else -%}
              {%- assign price_label = block.settings.label | downcase -%}
              {%- if price_label contains 'sweet' -%}
