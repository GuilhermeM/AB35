<link rel="stylesheet" href="{{ 'sale-page.css' | asset_url }}">
<section id="section-{{ section.id }}" class="sale_page_hero_section"{% if section.settings.background_color != blank %} style="background-color:{{section.settings.background_color}}"{% endif %}>
  <div class="FlexboxIeFix">
    <div class="ImageHero">
      <div class="ImageHero__ImageWrapper">
        {% comment %}
           {%- assign mobile_image = section.settings.mobile_image | default: block.settings.image -%}
          {%- if mobile_image -%}
            <div class="Slideshow__ImageContainer hidden-tablet-and-up"
                 style="background-image: url({{ mobile_image | img_url: '1x1', format: 'jpg' }})">
                <img class="Slideshow__Image Image--lazyLoad"
                     src="{{ mobile_image | img_url: '1x1' }}"
                     data-src="{{ mobile_image | img_url: 'x800' }}"
                     alt="{{ mobile_image.alt | escape }}">
                <noscript>
                  <img class="Slideshow__Image" src="{{ mobile_image | img_url: 'x800' }}" alt="{{ mobile_image.alt | escape }}">
                </noscript>
            </div>
          {%- endif -%}
          
            <div class="Slideshow__ImageContainer hidden-phone"
                 style="background-image: url({{ block.settings.image | img_url: '1x1', format: 'jpg' }})">
              {% assign image_url = section.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
              <img class="Slideshow__Image Image--lazyLoad hide-no-js"
                   data-src="{{ image_url }}"
                   data-optimumx="1.2"
                   data-widths="[400, 600, 800, 1000, 1200, 1400, 1600, 1800, 2000, 2200]"
                   data-sizes="auto"
                   alt="{{ section.settings.image.alt | escape }}">
              <noscript>
                <img class="Slideshow__Image" src="{{ section.settings.image | img_url: '1000x' }}" alt="{{ section.settings.image.alt | escape }}">
              </noscript>
            </div>
          {%- else -%}
            <div class="Slideshow__ImageContainer PlaceholderSvg--dark">
              {%- capture placeholder -%}{% cycle 'lifestyle-1', 'lifestyle-2' %}{%- endcapture -%}
              {{ placeholder | placeholder_svg_tag: 'Slideshow__Image PlaceholderBackground__Svg' }}
            </div>
          {%- endif -%}
        {% endcomment %}
      </div>
      <div class="ImageHero__Content">
        {%- if  section.settings.title != blank or section.settings.content != blank -%}
        <header class="SectionHeader">
          {%- if section.settings.title != blank -%}
          <h2 class="SectionHeader__Heading Heading u-h1">{{ section.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.content != blank -%}
          <div class="SectionHeader__Description">
            {{ section.settings.content }}
          </div>
          {%- endif -%}
          {%- if section.settings.btn_label != blank -%}
          <a href="javascript:void(0);" class="Button Button--secondary klaviyo_popup_button">{{section.settings.btn_label}}</a>
          {%- endif -%}
        </header>
        {%- endif -%}
        <div class="Content_inner">
          {% if section.settings.content_1 != blank %}
          <div class="Content_block">{{section.settings.content_1}}</div>
          {% endif %}
          {% if section.settings.content_2 != blank %}
          <div class="Content_block">{{section.settings.content_2}}</div>
          {% endif %}
        </div>
        {% if section.settings.show_countdown %}
        <div id="rounded-countdown" class="rounded-countdown-{{ section.id }}" data-section-id="{{ section.id }}" data-date="{{ section.settings.date }}">
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
<style>
  {% if section.settings.text_color != blank %}
  #section-{{ section.id }} .ImageHero__Content .SectionHeader .SectionHeader__Heading,
  #section-{{ section.id }} .ImageHero__Content .SectionHeader .SectionHeader__Description{
    color:{{section.settings.text_color}};
  }
  {% endif %}
  {%- if section.settings.image -%}
  #section-{{ section.id }} .ImageHero__ImageWrapper{
  	background:url({{ section.settings.image | img_url: '2000x' }}) no-repeat center right;
	background-size:cover;
  }
  {% endif %}
  {% if section.settings.background_color != blank %}
  #section-{{ section.id }} .ClassyCountdown-wrapper > div{
  	background-color:{{section.settings.background_color}};
  }
  {% endif %}
  @media screen and (max-width:640px){
    {%- assign mobile_image = section.settings.mobile_image | default: block.settings.image -%}
    {%- if mobile_image -%}
    #section-{{ section.id }} .ImageHero__ImageWrapper{
      background:url({{ mobile_image | img_url: '700x' }}) no-repeat bottom right;
      background-size:cover;
    }
    {% endif %}
  }
</style>
<script src="{{ 'jquery.knob.js' | asset_url }}" defer></script>
<script src="{{ 'jquery.throttle.js' | asset_url }}" defer></script>
<script src="{{ 'jquery.classycountdown.js' | asset_url }}" defer></script>
<script src="{{ 'sale-page.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Sale Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "1500 x 800px .jpg recommended"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image",
      "info": "1500 x 800px .jpg recommended"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
	  "default": "The<strong> Eid Takeover Sale Is Coming</strong>"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text",
      "default": "<p>Set your alarm and be one of the first on this historical sale: up to <strong>70%</strong> off across all our products</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "btn label",
	  "default": "Notify Me"
    },
    {
      "type": "richtext",
      "id": "content_1",
      "label": "sale box 1",
      "default": "<p>April 9th, 2022<strong> 12:00pm EST</strong></p>"
    },
    {
      "type": "richtext",
      "id": "content_2",
      "label": "sale box 2",
      "default": "<p>Products To<strong> Sell Out Fast</strong></p>"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show Countdown"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Date"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "background"
    }
  ],
  "presets": [
    {
      "category": "Image",
      "name": "Sale Hero Section",
      "settings": {}
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}

{% include 'klaviyo-script' %}


