<section {% if section.blocks.size == 0 %} hidden {% endif %}class="Section Section--spacingSmall" data-section-id="{{ section.id }}" data-section-type="icons">
  <div class="honepage-icons static-banner-icons">
    <div class="container">
      {%- if section.settings.subheading != blank or section.settings.title != blank -%}
      <header class="SectionHeader SectionHeader--center icons_section_header">
        {%- if section.settings.subheading != blank -%}
        <h3 class="SectionHeader__SubHeading Heading u-h6">{{ section.settings.subheading | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
        <h2 class="SectionHeader__Heading Heading u-h1">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </header>
      {%- endif -%}
      
      <div class="icons-wrapper">
      	{% for block in section.blocks %}
        <div class="icon-block">
          	{% if block.settings.icon != blank %}
              {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
              {% endif %}
                
                 {% assign image_url = block.settings.icon | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
          <img class="Image--lazyLoad hide-no-js"
               data-src="{{ image_url }}"
               data-optimumx="1.2"
               data-widths="[400, 600, 800, 1000, 1200, 1400, 1600, 1800, 2000, 2200]"
               data-sizes="auto"
               alt="{{ block.settings.icon.alt | escape }}"/>
              {% if block.settings.link != blank %}
              </a>
              {% endif %}
          	{% endif %}
           <div>
          	{% if block.settings.title != blank %}
              	<h2>{{ block.settings.title }}</h2>
          	{% endif %}
          	<div class="block-text">
          		{{ block.settings.text }}
          	</div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <span id="section-{{ section.id }}-end" class="Anchor"></span>
</section>



<style>
  #shopify-section-{{section.id}} .honepage-icons .icons-wrapper .icon-block h2 {
    {% if section.settings.title_font != blank %}
    font-family: {{ section.settings.title_font }};
    {% endif %}
    font-size: {{ section.settings.title_font_size }}px;
    {% if section.settings.title_color != blank %}
    color: {{ section.settings.title_color }};
    {% endif %}
  }

  #shopify-section-{{section.id}} .honepage-icons .icons-wrapper .icon-block .block-text p {
    {% if section.settings.text_font != blank %}
    font-family: {{ section.settings.text_font }};
    {% endif %}
    font-size: {{ section.settings.text_font_size }}px;
    {% if section.settings.text_color != blank %}
    color: {{ section.settings.text_color }};
    {% endif %}
  }
  
  #shopify-section-{{section.id}}{
    background: {{section.settings.section_background}};
  }

  @media only screen and (max-width: 1024px) {

    #shopify-section-{{section.id}} .icons-wrapper .icon-block {
      padding: 5px;
    }

    #shopify-section-{{section.id}} .icons-wrapper .icon-block h2 {
      line-height: 1.5;
    }

    #shopify-section-{{section.id}} .icons-wrapper .icon-block h2 p {
      font-size: 11px !important;
    }

  }
</style>

{% schema %}
{
  "name": "Static icons",
  "class": "shopify-section--bordered",
  "settings": [
      {
      "type": "text",
      "id": "subheading",
      "label": "Sub-heading"
      },
      {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Heading"
      },
	  {
        "type": "text",
        "id": "title_font",
        "label": "Title font"
      },
	  {
        "type": "text",
        "id": "text_font",
        "label": "Text font"
      },
	  {
        "type": "range",
        "id": "title_font_size",
        "label": "Title font size",
        "min": 13,
        "max": 40,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "text_font_size",
        "label": "Text font size",
        "min": 12,
        "max": 40,
        "unit": "px",
        "default": 14
      },
	  {
        "type": "color",
        "id": "title_color",
        "label": "Title color"
      },
	  {
        "type": "color",
        "id": "text_color",
        "label": "Text color"
      },
	  {
        "type": "color",
        "id": "section_background",
        "label": "Section background color",
		"default": "#efefef"
      }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
		{
          "type": "richtext",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"Static icons",
      "category":"Image"
    }
  ]
}
{% endschema %}