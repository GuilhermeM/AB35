</header>
<div id="nav-backdrop"></div>

<script>
  (function () {
    if (window.__nominalEarlyDrawerInit) return;
    window.__nominalEarlyDrawerInit = true;

    var DRAWER_ID = 'sidebar-menu';

    function getDrawer() { return document.getElementById(DRAWER_ID); }
    function getOverlay() { return document.querySelector('.PageOverlay'); }
    function isDrawerOpen() {
      var d = getDrawer();
      return d && d.getAttribute('aria-hidden') === 'false';
    }

    function openDrawer(e) {
      var drawer = getDrawer();
      if (!drawer) return;
      if (e) e.preventDefault();
      drawer.setAttribute('aria-hidden', 'false');
      drawer.style.maxHeight = window.innerHeight + 'px';
      document.documentElement.classList.add('no-scroll');
      var overlay = getOverlay();
      if (overlay) overlay.classList.add('is-visible');
    }

    function closeDrawer(e) {
      var drawer = getDrawer();
      if (!drawer) return;
      if (e) e.preventDefault();
      drawer.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('no-scroll');
      var overlay = getOverlay();
      if (overlay) overlay.classList.remove('is-visible');
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      if (t.closest('[data-action="open-drawer"][data-drawer-id="' + DRAWER_ID + '"]')) {
        openDrawer(e);
        return;
      }
      if (t.closest('[data-action="close-drawer"][data-drawer-id="' + DRAWER_ID + '"]')) {
        closeDrawer(e);
        return;
      }
      if (isDrawerOpen()) {
        var overlay = getOverlay();
        if (overlay && overlay.contains(t)) {
          closeDrawer(e);
        }
      }
    }, false);
  })();
</script>

<style>
  {% for block in section.blocks %}
  {% if block.settings.mega_menu_background_color != blank %}
  .menublock_{{block.id}}{
    background-color:{{block.settings.mega_menu_background_color | color_to_hsl |  color_modify: 'alpha', 0.8}};
    backdrop-filter: saturate(180%) blur(2rem);
  }
  {% endif %}
  {% if block.settings.text_color != blank %}
  .menublock_{{block.id}} p,.menublock_{{block.id}} li,.menublock_{{block.id}} a{
    color:{{block.settings.text_color}};
  }
  {% endif %}
  {% if block.settings.heading_color != blank %}
  .menublock_{{block.id}} .menu__heading{
    color:{{block.settings.heading_color}};
  }
  {% endif %}
  .menublock_{{block.id}} .tag-sale{
    background:{{block.settings.sale_badge_color}};
    color:{{block.settings.sale_color}};
  }
  .menublock_{{block.id}} .tag-new{
    background:{{block.settings.new_badge_color}};
    color:{{block.settings.new_color}};
  }
  {% endfor %}
  {%- if section.settings.use_sticky_header -%}
    :root {
      --use-sticky-header: 1;
      --use-unsticky-header: 0;
      --announcement-height:0;
    }

    .shopify-section--header {
      position: -webkit-sticky;
      position: sticky;
    }
      @media screen and (min-width:1140px){
        .shopify-section--header {
          top:var(--announcement-height);
        }
        #shopify-section-announcement {
          position: sticky;
          top: 0;
          left: 0;
          z-index: 9999999;
        }
        .Header{
          z-index: 999999 !important;
        }
        .shopify-section--header {
          z-index: 9999 !important;
        }
      }
  {%- else -%}
    :root {
      --use-sticky-header: 0;
      --use-unsticky-header: 1;
    }
  {%- endif -%}

  {%- if section.settings.logo -%}
    .Header__LogoImage {
      max-width: {{ section.settings.logo_max_width }}px;
    }

    @media screen and (max-width: 640px) {
      .Header__LogoImage {
        max-width: {{ section.settings.mobile_logo_max_width }}px;
      }
    }
  {%- endif -%}

  {%- if use_transparent_header -%}
    :root {
      --header-is-not-transparent: 0;
      --header-is-transparent: 1;
    }

    .shopify-section--header {
      margin-bottom: calc(-1 * var(--header-height));
    }

    .supports-sticky .Search[aria-hidden="true"] + .Header--transparent {
      {%- if section.settings.show_transparent_header_border -%}
        box-shadow: 0 -1px {{ section.settings.transparent_text_color | color_modify: 'alpha', 0.25 }} inset;
      {%- else -%}
        box-shadow: none;
      {%- endif -%}

      color: {{ section.settings.transparent_text_color }};
    }
  {%- else -%}
    :root {
      --header-is-not-transparent: 1;
      --header-is-transparent: 0;
    }
  {%- endif -%}
</style>

<script>
  document.documentElement.style.setProperty('--header-height', document.getElementById('shopify-section-header').offsetHeight + 'px');
   document.documentElement.style.setProperty('--announcement-height', document.getElementById('shopify-section-announcement').offsetHeight + 'px');
</script>

