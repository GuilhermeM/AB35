<section id="section-{{ section.id }}" class="Section {% unless section.settings.image %}Section--spacingNormal{% endunless %}"{% if section.settings.background_color != blank %} style="background:{{section.settings.background_color}};"{% endif %}>
  {%- capture section_content -%}
    <div class="FeatureText__ContentWrapper {% if section.settings.content_overlay %}FeatureText__Content--{{ section.settings.content_position }}{% endif %} FeatureText__align--{{ section.settings.content_align }}">
      <div class="FeatureText__Content">
        {%- if section.settings.subheading != blank -%}
          <h3 class="SectionHeader__SubHeading Heading u-h6">{{ section.settings.subheading | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="SectionHeader__Heading SectionHeader__Heading--emphasize Heading u-h1">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <div class="SectionHeader__Description Rte">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
        
        {%- if section.settings.show_newsletter -%}
        	<div class="klaviyo-form-XdTFEL"></div>
        {%- endif -%}
        
        {%- if section.settings.button_1_text != blank and section.settings.button_2_text != blank -%}
          {%- assign has_two_buttons = true -%}
        {%- else -%}
          {%- assign has_two_buttons = false -%}
        {%- endif -%}

        {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
          <div class="SectionHeader__ButtonWrapper">
            <div class="ButtonGroup ButtonGroup--spacingSmall {% if has_two_buttons %}ButtonGroup--sameSize{% endif %}">
              {%- if section.settings.button_1_text != blank -%}
              	<a href="{{ section.settings.button_1_link }}" class="ButtonGroup__Item Button">{{ section.settings.button_1_text | escape }}</a>
              {%- endif -%}

              {%- if section.settings.button_2_text != blank -%}
              	<a href="{{ section.settings.button_2_link }}" class="ButtonGroup__Item Button">{{ section.settings.button_2_text | escape }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  
  {%- endcapture -%}

  {%- capture section_image -%}
    {%- if section.settings.image != blank -%}
      <div class="FeatureText__ImageWrapper {% if section.settings.content_overlay %}has-overlay-content{% endif %}">
        {%- capture supported_sizes -%}{%- render 'image-size', sizes: '400,600,700,800,900,1000,1200', image: section.settings.image -%}{%- endcapture -%}

        <div class="AspectRatio hidden-phone" style="max-width: {{ section.settings.image.width }}px; --aspect-ratio: {{ section.settings.image.aspect_ratio }}">
          {%- assign image_url = section.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
          <img class="Image--lazyLoad Image--slide{{ section.settings.image_position | capitalize }}" data-src="{{ image_url }}" data-expand="-200" data-widths="[{{ supported_sizes }}]" data-sizes="auto" alt="{{ section.settings.image.alt | escape }}">

          <noscript>
            <img src="{{ section.settings.image | img_url: '800x' }}" alt="{{ section.settings.image.alt | escape }}">
          </noscript>
        </div>
        
        {%- assign mobile_image = section.settings.mobile_image | default: section.settings.image -%}
        
        {%- if mobile_image -%}
        <div class="AspectRatio hidden-tablet-and-up" style="max-width: {{ mobile_image.width }}px; --aspect-ratio: {{ mobile_image.aspect_ratio }}">
          {%- assign image_url = mobile_image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
          <img class="Image--lazyLoad " data-src="{{ image_url }}" data-expand="-200" data-widths="[{{ supported_sizes }}]" data-sizes="auto" alt="{{ mobile_image.alt | escape }}">

          <noscript>
            <img src="{{ mobile_image | img_url: '800x' }}" alt="{{ mobile_image.alt | escape }}">
          </noscript>
        </div>
        {%- endif -%}
        
        {%- if section.settings.content_overlay -%}
        	{{- section_content -}}
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endcapture -%}

  <div class="FeatureText {% if section.settings.image != blank %}FeatureText--withImage FeatureText--image{{ section.settings.image_position | capitalize }}{% endif %}">
    {%- if section.settings.image_position == 'left' -%}
      {{- section_image -}}
      {%- unless section.settings.content_overlay -%}
        {{- section_content -}}
      {%- endunless -%}
    {%- else -%}
      {%- unless section.settings.content_overlay -%}
        {{- section_content -}}
      {%- endunless -%}
      {{- section_image -}}
    {%- endif -%}
  </div>
</section>


<style>
  #section-{{ section.id }} .Heading,
   #section-{{ section.id }} .SectionHeader__Description p {
    color: {{ section.settings.text_color }};
  }

  #section-{{ section.id }} .Button {
    color: {{ section.settings.button_color }};
    border-color: {{ section.settings.button_background }};
  }

  #section-{{ section.id }} .Button::before {
    background-color: {{ section.settings.button_background }};
  }

  {%- if settings.show_button_transition -%}
    @media (-moz-touch-enabled: 0), (hover: hover) {
      #section-{{ section.id }} .Button:hover {
        color: {{ section.settings.button_background }};
      }
    }
  {%- endif -%}
</style>

{% schema %}
{
  "name": "Custom text with image",
  "class": "shopify-section--bordered custom-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "1800 x 800px .jpg recommended"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "750 x 1100px .jpg recommended. If none is set, desktop image will be cropped."
    },
	{
      "type": "checkbox",
      "id": "content_overlay",
      "label": "Content overlay",
      "default": false
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "middleLeft",
          "label": "Middle left"
        },
        {
          "value": "middleCenter",
          "label": "Middle center"
        },
        {
          "value": "middleRight",
          "label": "Middle right"
        },
        {
          "value": "bottomLeft",
          "label": "Bottom left"
        },
        {
          "value": "bottomCenter",
          "label": "Bottom center"
        },
        {
          "value": "bottomRight",
          "label": "Bottom right"
        }
      ],
      "default": "bottomLeft"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content Alignment",
      "options": [
        {
          "value": "textLeft",
          "label": "left"
        },
        {
          "value": "textCenter",
          "label": "center"
        },
        {
          "value": "textRight",
          "label": "right"
        }
      ],
      "default": "textCenter"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub-heading",
      "default": "Slide title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Tell your story"
    },
	{
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": false
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text",
      "default": "<p>Add your own custom content to give more information about your store, availability details...</p>"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fff"
    },
	{
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
	{
      "type": "color",
      "id": "button_color",
      "label": "Button text",
      "default": "#363636"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "category": "Text",
      "name": "Custom text with image",
      "settings": {}
    }
  ]
}
{% endschema %}