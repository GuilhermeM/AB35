{%- assign main_menu_handle = section.settings.primary_menu | default: 'main-menu' -%}
{%- assign main_menu = linklists[main_menu_handle] -%}

<section id="sidebar-menu" class="SidebarMenu Drawer Drawer--small Drawer--fromLeft" aria-hidden="true" i data-section-id="{{ section.id }}" data-section-type="sidebar-menu">
  <header class="Drawer__Header" data-drawer-animated-left>
    <button class="Drawer__Close Icon-Wrapper--clickable" data-action="close-drawer" data-drawer-id="sidebar-menu" aria-label="{{ 'header.navigation.close_sidebar' | t }}">
      {%- render 'icon' with 'close' -%}
    </button>
    <div class="Sidebarmenu_Nav_Tab">
            <div class="sidemenu-tab-wrapper">
              {%- for link in main_menu.links -%}
                <div class="Collapsible {% if forloop.first %}activeTab{% endif %}" data-tab-handle="{{link.handle}}">
                  {%- if link.links != blank -%}
                    <button class="Collapsible__Button Heading u-h6" data-action="toggle-collapsible" {% if link.links != blank %}aria-expanded="false"{% endif %}>
                      {{- link.title | escape -}}
                    </button>
                    {%- else -%}
                    <a href="{{ link.url }}" class="Collapsible__Button Heading Link Link--primary u-h6">{{ link.title | escape }}</a>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
  </header>
  
  <div class="Drawer__Content">
    <div class="Drawer__Main" data-drawer-animated-left data-scrollable>
      <div class="Drawer__Container">
        <div class="SidebarMenu_Primary_content">
          
          <nav class="SidebarMenu__Nav nav-tab-contents  SidebarMenu__Nav--primary" aria-label="{{ 'header.navigation.sidebar_title' | t }}">
            {%- for link in main_menu.links -%}
              {%- if link.links != blank -%}  
              <div class="Collapsible tab-content-wrapper {% unless forloop.first %}tab-contents{% endunless %}" data-tab="{{link.handle}}">
                <div class="Collapsible__Inner">
                <div class="Collapsible">
                    {%- for sub_link in link.links -%}
                      {% unless sub_link.handle == 'help'  %}
                        <div class="Collapsible__Content collapsible-content-wrapper">
                        {%- if sub_link.links != blank -%}
                          <button class="Collapsible__Button Heading Text--subdued Link--primary u-h7" data-action="toggle-collapsible" {% if sub_link.links != blank %}aria-expanded="false"{% endif %}>
                            {{- sub_link.title | escape -}}
                          </button>
                          <div class="Collapsible__Inner">
                            <div class="Collapsible__Content">
                              <ul class="Linklist Linklist--bordered Linklist--spacingLoose">
                                {%- for sub_sub_link in sub_link.links -%}
                                  <li class="Linklist__Item">
                                    <a href="{{ sub_sub_link.url }}" class="Text--subdued Link Link--primary">
                                      <span>{{ sub_sub_link.title | escape }}</span>
                                      {% if sub_sub_link.handle contains 'new' %}
                                      	<span class="tag-new tag-content">NEW</span>
                                      {% endif %}
                                      {% if sub_sub_link.handle contains 'clearance' %}	
                                      	<span class="tag-sale tag-content">SALE</span>
                                      {% endif %}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          </div>
                          {%- else -%}
                          <a href="{{ sub_link.url }}" class="Collapsible__Button Heading Text--subdued Link Link--primary u-h7">
                            {{ sub_link.title | escape }}
                        </a>
                        {%- endif -%}
                      </div>
                        {% endunless %}
                    {%- endfor -%}
                                    
                  </div>
{%- for sub_link in link.links -%}
                      {% if sub_link.handle == 'help'  %}
                      <div class="Collapsible" style="margin-left: 0;">
                        {%- if sub_link.links != blank -%}
                          <button class="Collapsible__Button Heading Text--subdued Link--primary u-h7" data-action="toggle-collapsible" {% if sub_link.links != blank %}aria-expanded="false"{% endif %}>
                            {{- sub_link.title | escape -}}
                          </button>
                          <div class="Collapsible__Inner">
                            <div class="Collapsible__Content">
                              <ul class="Linklist Linklist--bordered Linklist--spacingLoose">
                                {%- for sub_sub_link in sub_link.links -%}
                                  <li class="Linklist__Item">
                                    <a href="{{ sub_sub_link.url }}" class="Text--subdued Link Link--primary">
                                      <span>{{ sub_sub_link.title | escape }}</span>
                                      {% if sub_sub_link.handle == 'newest-releases' %}
                                      	<span class="tag-new tag-content">NEW</span>
                                      {% endif %}
                                      {% if sub_sub_link.handle contains 'clearance' %}	
                                      	<span class="tag-sale tag-content">SALE</span>
                                      {% endif %}	
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          </div>
                          {%- else -%}
                          <a href="{{ sub_link.url }}" class="Collapsible__Button Heading Text--subdued Link Link--primary u-h7">
                            {{ sub_link.title | escape }}
                        </a>
                        {%- endif -%}
                      </div>
                        {% endif %}
                    {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
            <div class="menu-collections-content">
              <div class="menu-collections-content-main">
                {% for block in section.blocks %}                
                <div class="menu-collections-wrapper tab-content-wrapper {% unless forloop.first%} tab-contents{% endunless %}" data-img-tab="{{block.settings.navigation_mega_menu | downcase}}">
                  {% for i in (1..5) %}
                  {% capture img %}push_{{i}}_image{% endcapture %}
                  {% capture heading %}push_{{i}}_heading{% endcapture %}
                  {% capture headingcolor %}push_{{i}}_heading_color{% endcapture %}
                  {% capture url %}push_{{i}}_url{% endcapture %}
                  {% if block.settings[img] != blank %}
                  <div class="collections-info-wrapper MegaMenu__Imageblock">
                      {% render 'mega-menu__imageblock', image: block.settings[img], heading: block.settings[heading], heading_color: block.settings[headingcolor], link: block.settings[url] %}
                  </div>
                  {% endif %}
                  {% endfor %}
                </div>
                {% endfor %}
              </div>
            </div>
        </nav>
        
      </div>
      
        <div class="menu-bottom-content">
      {%- assign secondary_menu = linklists[section.settings.secondary_menu] -%}
     
    
    <nav class="SidebarMenu__Nav SidebarMenu__Nav--secondary">
      <ul class="Linklist Linklist--spacingLoose">
        {%- for link in secondary_menu.links -%}
          <li class="Linklist__Item">
            <a href="{{ link.url }}" class="Text--subdued Link Link--primary">
              {% for a in (1..12) %}
              {% capture menuName %}menuname_{{a}}{% endcapture %}
              {% capture svgHtml %}svgHtml_{{a}}{% endcapture %}
              {% assign menuNameIs = section.settings[menuName] | downcase %}
                {% if link.handle == menuNameIs %}
              		{{section.settings[svgHtml]}}
                {% endif %}
              {% endfor %}
              <span class="{{link.handle}}">{{ link.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
        
        {%- comment -%}We automatically add some links to the secondary menu{%- endcomment -%}
        
        {%- if shop.customer_accounts_enabled -%}
          <li class="Linklist__Item">
            <a href="{{ routes.account_url }}" class="Text--subdued Link Link--primary">
              <svg width="700pt" height="700pt" version="1.1" viewBox="0 0 700 700" xmlns="http://www.w3.org/2000/svg">
               <path d="m350 35c-64.977 0-127.29 25.812-173.24 71.758-45.945 45.949-71.758 108.27-71.758 173.24s25.812 127.29 71.758 173.24c45.949 45.945 108.27 71.758 173.24 71.758s127.29-25.812 173.24-71.758c45.945-45.949 71.758-108.27 71.758-173.24 0-43.008-11.32-85.254-32.824-122.5-21.504-37.246-52.43-68.172-89.676-89.676-37.246-21.504-79.492-32.824-122.5-32.824zm0 140c18.566 0 36.371 7.375 49.496 20.504 13.129 13.125 20.504 30.93 20.504 49.496s-7.375 36.371-20.504 49.496c-13.125 13.129-30.93 20.504-49.496 20.504s-36.371-7.375-49.496-20.504c-13.129-13.125-20.504-30.93-20.504-49.496s7.375-36.371 20.504-49.496c13.125-13.129 30.93-20.504 49.496-20.504zm0 315c-49.852 0.11328-98.094-17.641-135.98-50.051 11.25-46.797 45.75-84.531 91.352-99.926 28.27 13.273 60.98 13.273 89.25 0 45.602 15.395 80.102 53.129 91.352 99.926-37.883 32.41-86.125 50.164-135.98 50.051z"/>
              </svg>
              <span>{{ 'header.navigation.account' | t }}</span>
            </a>
          </li>
        {%- endif -%}
      </ul>
    </nav>
        </div>
  </div>
</div>

{%- if section.settings.show_social_media -%}
  {%- capture social_media -%}
  {% render 'social-media', class: 'SidebarMenu__Social', spacing: 'fill' %}
  {%- endcapture -%}
{%- endif -%}

{%- if social_media != blank -%}
  <aside class="Drawer__Footer" data-drawer-animated-bottom>
    {%- if social_media != blank -%}
      {{ social_media }}
    {%- endif -%}
  </aside>
{%- endif -%}
</div>
</section>
