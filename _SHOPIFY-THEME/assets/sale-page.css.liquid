.sale_page_hero_section .ImageHero img.Slideshow__Image {
  opacity: 1;
}
.sale_page_hero_section .ImageHero {
  justify-content: flex-start;
}
.sale_page_hero_section .ImageHero__Content {
  position: relative;
  padding: 80px 20px 20px 100px;
  text-align: left;
}
.sale_page_hero_section .ImageHero__Content .SectionHeader__Heading {
  font-size: 48px;
  max-width: 500px;
  line-height: 1.2;
  width: 100%;
}
.sale_page_hero_section .ImageHero__Content .SectionHeader__Description {
  font-size: 20px;
  line-height: 1.3;
  margin-bottom: 25px;
}
.sale_page_hero_section .klaviyo_popup_button {
  background-color: #fff;
  max-width: 220px;
  width: 100%;
}
.sale_page_hero_section .ImageHero__Content header.SectionHeader {
  margin-bottom: 0;
}
div#rounded-countdown {
  margin-top:20px;
  max-width: 380px;
  width: 100%;
}
.ClassyCountdown-wrapper > div {
  display: inline-block;
  position: relative;
  width: calc(25% - 14px);
  margin: 7px;
  border-radius: 100%;
  background-color: #fff;
}
.ClassyCountdown-wrapper .ClassyCountdown-value {
  text-align: center;
}
.ClassyCountdown-wrapper .ClassyCountdown-value>div {
  font-weight: 700;
  width: 100%;
  line-height: 1;
  position: absolute;
  top: 52%;
  transform: translateY(-50%);
  text-align: center;
  left: 0;
  display: block;
  font-size: 30px;
}
.ClassyCountdown-wrapper .ClassyCountdown-value span {
  display: block;
  text-shadow: 1px 2px #fff;
}
.Content_inner {
  display: flex;
  align-items: center;
  margin-top: 25px;
}
.Content_inner .Content_block {
  width: 180px;
  height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-right: 15px;
  background: #efeff2;
  text-align: center;
  font-size: 19px;
  padding: 10px;
}
.Content_inner .Content_block strong {
  display: block;
}
.register-step-section .section_block_grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  grid-gap: 100px;
  position: relative;
}
.register-step-section .section_block_grid:after {
  content: '';
  position: absolute;
  width: 100%;
  border: 1px dashed #e2e2e2;
  left: 50%;
  top: 44%;
  transform: translate(-50%,-50%);
  z-index: -1;
}
.register-step-section {
  padding: 80px 0;
}
.register-step-section .block_grid .BannerItem__ImageWrapper {
  border-radius: 100%;
  overflow: hidden;
}
.register-step-section .block_grid .BannerItem__Content {
  text-align: center;
  margin-top: 20px;
}
.block_grid .BannerItem__Content span {
  font-size: 17px;
  font-weight: 600;
  text-decoration: underline;
  color: #000;
}
.block_grid .BannerItem__Content .content {
  font-size: 17px;
  line-height: 1.3;
  margin-top: 12px;
  color: #000;
}
.block_grid .BannerItem__Content .content a {
  font-weight: 600;
  text-decoration: underline;
}
@media screen and (max-width:1199px){
  .sale_page_hero_section .ImageHero__Content{
  	padding:45px 20px 20px 50px;
  }
  .sale_page_hero_section .ImageHero__Content .SectionHeader__Heading{
    font-size: 34px;
    max-width: 380px;
  }
  .sale_page_hero_section .ImageHero__Content .SectionHeader__Description{
    font-size:16px;
    margin-bottom: 20px;
    margin-top: 0;
  }
  .Content_inner .Content_block{
    width: 140px;
    height: 140px;
    font-size: 15px;
  }
}
@media screen and (max-width:991px){
  .sale_page_hero_section .ImageHero__Content{
    padding: 25px 20px 20px 25px;
  }
  .sale_page_hero_section .ImageHero__Content .SectionHeader__Heading{
    font-size: 28px;
    max-width: 310px;
    margin-bottom: 15px;
  }
  .sale_page_hero_section .ImageHero__Content .SectionHeader__Description {
    font-size: 15px;
    max-width: 400px;
  }
  .sale_page_hero_section .klaviyo_popup_button{width:auto;}
  .Content_inner .Content_block{
    width: 120px;
    height: 120px;
    font-size: 14px;
  }
  .register-step-section .section_block_grid{
    grid-gap: 20px;
  }
  .register-step-section .section_block_grid:after{top:37%;}
  .block_grid .BannerItem__Content .content{font-size:16px;}
}
@media screen and (max-width:767px){
  .block_grid .BannerItem__Content .content{
    font-size: 14px;
  }
  .register-step-section .section_block_grid:after{display:none;}
  .progress-timer--unit-container .progress-timer_unit{
    font-size: 13px;
    padding: 0 7px;
  }
  .progress-timer--unit-container .progress-timer_unit .unit {
    font-size: 20px;
    line-height: 1.2;
  }
  .progress-timer--unit-container .progress-timer_unit span.count_label {
    color: #666;
    font-weight: 600;
  }
}
@media screen and (max-width:640px){
  .register-step-section {
    padding: 40px 0;
  }
  .register-step-section .section_block_grid {
    grid-template-columns: repeat(1,1fr);
  }
  .register-step-section .section_block_grid .BannerItem__ImageWrapper {
    max-width: 250px;
    margin: 0 auto;
  }
  .register-step-section .block_grid .BannerItem__Content{margin-top:10px;}
  .block_grid .BannerItem__Content .content{margin-top:5px;}
  .sale_page_hero_section .ImageHero__Content {
    padding: 20px;
  }
  .sale_page_hero_section .ImageHero__ImageWrapper {
    background-size: 55% !important;
  }
  .Content_inner .Content_block {
    width: 100px;
    height: 100px;
    font-size: 13px;
    padding: 5px;
    margin-right: 10px;
  }
}
@media screen and (max-width:480px){
  .Content_inner .Content_block {
    width: 90px;
    height: 90px;
    font-size: 12px;
  }
}