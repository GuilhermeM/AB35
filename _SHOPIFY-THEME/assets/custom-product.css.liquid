.CustomProduct__Section .SectionHeader {
  margin-bottom: 25px;
}
.CustomProduct__Section .SectionHeader__Heading{
  font-size: 34px;
}
.CustomProduct__Section .SectionFooter{
  margin-top: 30px;
}
.CustomProduct__ImageWrapper {
  border: 2px solid #C4C4C4;
  position: relative;
}
h2.CustomProductItem___Heading {
  font-family: "Instrument Sans";
  text-align: center;
  margin-top: 24px;
  font-size: 16px;
  color: #1C1B1B;
  line-height: 24.35px;
  font-weight: 300;
}
.CustomProduct__Time {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  padding: 0 40px;
}
.CustomProductTime__Detail {
  background-color: #fff;
  padding: 15px 20px;
  text-align: center;
  font-family: "Instrument Sans";
}
.CustomProductTime__Detail h2 span {
  display: block;
  font-size: 24px;
  font-weight: 600;
}


.Newsletter__Section .Container{
  max-width: 1100px;
  width: 100%;
}
.Newsletter__Wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  grid-column-gap: 47px;
  background-color: #BCC4CC1A;
  border-radius: 6px;
}
.Newsletter__Wrapper .Newsletter__Form {
  padding: 38px 30px 30px 0;
}
.Newsletter__ImageWrapper .AspectRatio{
  max-width: 100%!important;
}

.Newsletter__Wrapper .Newsletter__Form .klaviyo-form.klaviyo-form.klaviyo-form{
  max-width: 100% !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}
.Newsletter__Section .klaviyo-form-Ypcfcc.klaviyo-form [data-testid="form-row"]:nth-child(2){
  display: block!important;
}
.Newsletter__Section .klaviyo-form-Ypcfcc.klaviyo-form [data-testid="form-row"] [data-testid="form-component"]{
  padding-left:0 !important;
}
.Newsletter__Section .klaviyo-form-Ypcfcc.klaviyo-form [data-testid="form-row"] [data-testid="form-component"]{
	outline:none;
  box-shadow:none;
}
.Newsletter__Section .klaviyo-form-Ypcfcc.klaviyo-form [data-testid="form-row"] [data-testid="form-component"] input{
  border: 0 !important;
  border-bottom: 1px solid #000000 !important;
  background-color: transparent !important;
  padding-left: 0 !important;
  border-radius: 0 !important;
      box-shadow: none !important;
}
.Newsletter__Section .klaviyo-form-Ypcfcc.klaviyo-form [data-testid="form-row"] [data-testid="form-component"] input::placeholder{
  color: #000000 !important;
}
.Newsletter__Section .klaviyo-form-Ypcfcc.klaviyo-form [data-testid="form-row"]:nth-child(2) [data-testid="form-component"]:nth-child(2){
  margin-top: 17px;
}
.Newsletter__Section .klaviyo-form-Ypcfcc.klaviyo-form [data-testid="form-row"]:nth-child(2) [data-testid="form-component"]:nth-child(2) button{
  background-color: #000000 !important;
  border-radius: 6px!important;
  max-width: 300px!important;
  padding-top: 20px!important;
  padding-bottom: 20px!important;
  width: 100%!important;
}
.Newsletter__Section .klaviyo-form-Ypcfcc.klaviyo-form [data-testid="form-row"]:nth-child(3){}

@media screen and (max-width: 1400px){
  .CustomProduct__Time {
    padding: 0 30px;
  }
  .CustomProductTime__Detail h2 span {
    font-size: 20px;
  }
}
@media screen and (max-width: 1140px){
  .CustomProduct__Section .Container {
    padding: 0 50px;
  }
  .CustomProduct__Section .CustomProduct__grid {
    padding: 0;
  }
}

@media screen and (max-width: 798px){
  .CustomProduct__Time {
    padding: 0 20px;
  }
  .CustomProductTime__Detail h2 span {
    font-size: 16px;
  }
}
@media screen and (max-width: 768px){
  .Newsletter__Wrapper {
    grid-template-columns: 1fr;
  }
  .Newsletter__ImageWrapper .AspectRatio img{
    border-radius: 6px;
  }
  .Newsletter__Wrapper .Newsletter__Form {
    padding:30px;
  }
}

@media screen and (max-width: 640px){
  .CustomProduct__Section .Container {
    padding: 0 24px;
  }
  h2.CustomProductItem___Heading {
    margin-top: 15px;
    font-size: 13px;
    line-height: normal;
  }
  .CustomProduct__Section .SectionHeader__Heading {
    font-size: 24px;
  }
}
@media screen and (max-width: 480px){
  .Newsletter__Wrapper .Newsletter__Form {
    padding: 15px;
  }
}
@media screen and (max-width: 375px){
  .CustomProduct__Time {
    padding: 0 5px;
  }
  .CustomProductTime__Detail {
    padding: 10px 10px;
  }
  .CustomProductTime__Detail h2 {
    font-size: 10px;
    line-height: normal;
  }
  .CustomProductTime__Detail h2 span {
    font-size: 12px;
    line-height: normal;
  }
}
}
 button.btn.btn--full.add-to-cart {
    border-radius: 78px !important;
}