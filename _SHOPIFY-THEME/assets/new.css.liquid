/* image with text Overlay section */
.eid-sale-banner .Image_with_text_overlay_container .overlay_main_content{
	max-width:841px;
  margin:0 auto;
}
.needsclick.kl-private-reset-css-Xuajs1 button {
    border: 2px solid black;
}
.eid-sale-banner.Image_with_text_overlay_section .Image_with_text_overlay_content_bar {
  position: relative;
}
.eid-sale-banner.Image_with_text_overlay_section .overlay_Image_content {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  transform: translate(-50%, -50%);
  z-index: 1;
}
.eid-sale-banner .Image_with_text_overlay_image_bar {
  position: relative;
}
.eid-sale-banner .Image_with_text_overlay_image_bar::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7));
}
.eid-sale-banner.Image_with_text_overlay_section .overlay_Image_content .overlay_main_content .overlay_image_button {
  padding: 7px 50px;
}
.eid-sale-banner .Image_with_text_overlay_content_bar .overlay_Image_content .overlay_main_content {
  text-align: center;
}
.eid-sale-banner .Image_with_text_overlay_content_bar .overlay_Image_content .overlay_main_content h2 {
  line-height: 1.3;
}
.eid-sale-banner .Image_with_text_overlay_content_bar .Image_with_text_overlay_animation_label {
  line-height: normal;
}
.eid-sale-banner .Image_with_text_overlay_animation_label .off_label {
  padding: 5px;
  display: inline-block;
}

/* FAQ section */
.left-and-right-side-faq {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 50px;
}
.PageContent--narrow {
  max-width: 1240px;
}
.faq-custom-data .faq_heading h2 {
  font-size: 30px;
  text-align: center;
  font-weight: bold;
}
.faq-custom-data .Faq__Answer.SectionHeader__Description.Rte {
    margin-top: 0;
}
.faq-custom-data .Faq .Faq__Item  .Faq__Icon {
  top: auto;
}
.faq-custom-data .Faq__Icon svg {
    width: 20px;
    height: 14px;
    vertical-align: baseline;
}
.faq-custom-data .Faq .Faq__Item {
  box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
  padding: 20px;
}
.faq-custom-data .Faq__Item .Faq__ItemWrapper{
	position:relative;
}
.faq-custom-data .Faq__Item .Faq__ItemWrapper .Faq__Question {
  font-weight: bold;
  font-size:22px;
  
}
.off_label.white-txt {
  color: #fff;
}


@media only screen and (max-width: 1279px) {
  .eid-sale-banner .Image_with_text_overlay_content_bar .overlay_Image_content .overlay_main_content h2 {
    font-size: 30px !important;
  }
}

@media only screen and (max-width: 1023px) {
  .eid-sale-banner .Image_with_text_overlay_content_bar .overlay_Image_content .overlay_main_content h2 {
    font-size: 20px !important;
  }
}
@media only screen and (max-width: 840px) {
  .left-and-right-side-faq {
    display: block;
  }
}
@media only screen and (max-width: 797px) {
  .eid-sale-banner.Image_with_text_overlay_section .overlay_Image_content {
    position: inherit;
    top: auto;
    left: auto;
    width: 100%;
    transform: inherit;
    margin: 20px 0;
  }
  .left-and-right-side-faq {
    display: block;
  }
  .faq-custom-data .Faq__Item .Faq__ItemWrapper .Faq__Question {
    font-size: 18px;
  }
}
