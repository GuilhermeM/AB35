.mineBtn
.swiper-container {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  height: 230px;
}
.CollectionToolbar {
    z-index: 99;
}
.swiper-slide {
  width: 100% !important; /* Each slide takes full container width */
  box-sizing: border-box;
}
.icons-wrapper .eg-icon-block:nth-last-child(-n + 2) {
  display: none;
}


.swiper-slide img {
    width: 100%;
    height: 100%;
    display: block;
    max-width: 100%;
    object-fit: cover;
}
.mobileSwiperMine {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none; /* Firefox */
}

.mobileSwiperMine::-webkit-scrollbar {
  display: none; /* Chrome, Safari */
}

.mobileSwiperMine .slide-box {
  flex: 0 0 100%; /* Each slide takes full swiper width */
  scroll-snap-align: start;
  box-sizing: border-box;
}

.mobileSwiperMine .slide-box img {
  width: 100%;
  height: auto;
  display: block;
}


.mobileSwiper .slide-box {
    width: 200px;
    height: 200px;
    object-fit: cover;
}
.mobile-search-info{
  display: flex !important;
}
