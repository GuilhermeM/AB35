/* Main Card */
 .eg-card {
    display: flex;
    align-items: center;
    background: #F1EFEA;
    cursor: pointer;
    max-width: 700px;
    margin: 30px auto 40px;
}

 .eg-card img {
    width: 150px;
    margin-right: 24px;
}

 .eg-card-content h2 {
    font-weight: 500;
    ;
    font-size: 16px;
    line-height: 140%;
    vertical-align: middle;
    text-transform: capitalize;
    color: #1C1B1B;
    margin: 0;
}

 .eg-card-content p {
    margin: 8px 0;
    font-family: "Instrument Sans";
    font-weight: 400;
    font-size: 12px;
    line-height: 140%;
    vertical-align: middle;
    color: #333;
}

 .eg-card-content a {
    color: #000;
    text-decoration: underline;
    font-family: "Instrument Sans";
    font-weight: 700;
    font-size: 14px;
    line-height: 140%;
    vertical-align: middle;
    cursor: pointer;
    text-underline-offset: 2px;
}

 .eg-card-content {
    padding: 15px 24px 15px 0;
}

/* Popup Overlay */
 .eg-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

/* Popup */
 .eg-popup {
    background: #fff;
    max-width: 862px;
    width: 100%;
    padding: 32px;
    position: relative;
    text-align: left;
    display: flex;
    gap: 32px;
}

 .eg-popup-content {
    max-width: 455px;
}

 .eg-popup h2 {
    margin-top: 0;
    margin-bottom: 16px;
    font-family: "Instrument Sans", sans-serif;
    font-weight: 500;
    font-size: 40px;
    line-height: 140%;
    color: #000;
}

 .eg-popup p {
    color: #333;
    font-family: "Instrument Sans", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 160%;
    vertical-align: middle;
    margin: 0;
}

 .eg-popup-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 0;
}

 .eg-popup-images img {
    width: 147px;
    height: 147px;
    object-fit: cover;
}

/* Close icon */
 .eg-close-icon {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 30px;
    height: 30px;
    cursor: pointer;
}

/* Close text */
 .eg-close-text {
    display: none;
}

