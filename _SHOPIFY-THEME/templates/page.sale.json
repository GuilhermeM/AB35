    "1648559787d7b12ea5": {
      "type": "eid-takeover-faq",
      "blocks": {
        "8c666394-667c-4e89-844e-88669321f07f": {
          "type": "left",
          "settings": {
            "title": "What to expect after you add to your Wishlist?",
            "answer": "<p>Once the sale is live, you’ll get a notification and be able to go straight to your Wishlist for a faster checkout. BUT just having an item on your Wishlist doesn’t guarantee that you’ll get it, because other people may have already ordered it. Make sure you head to checkout the <strong>moment</strong> you get the notification about the sale going live to ensure you get all of your carefully selected gifts before they’re gone! </p>"
          }
        },
        "fa67ea6e-a0d5-4fb0-8ec1-0285274e469e": {
          "type": "right",
          "settings": {
            "title": "Will I receive my order before EID?",
            "answer": "<p>Of course! Why else would we be the #1 store for EID gifts since 2017? </p>"
          }
        },
        "4acf5986-b4c7-48de-8253-66529138c493": {
          "type": "left",
          "settings": {
            "title": "What is the Return/Exchange Policy?",
            "answer": "<p>We accept returns of non-custom made pieces in good and sellable condition within 60 days of their arrival. For more details about our return and exchange policy click <a href=\"https://nominalx.com/pages/return-policy\"><span style=\"text-decoration:underline\">here</span></a>. (make this hyperlink open up a different tab)</p>"
          }
        },
        "802e7d34-be62-4289-bb90-05cab9f08669": {
          "type": "right",
          "settings": {
            "title": "Will the new items be discounted?",
            "answer": "<p>Yes! All of our items are discounted during our EID sale except for our custom pieces. </p>"
          }
        },
        "66f6240a-0a93-47d8-b4db-5d0c66c9e5fc": {
          "type": "left",
          "settings": {
            "title": "Do all products have lifetime warranty?",
            "answer": "<p>Wallaw? Of course all of our products have a lifetime warranty. </p>"
          }
        },
        "d58fae2e-1370-4319-bf16-7b4f0d92a586": {
          "type": "right",
          "settings": {
            "title": "How fast will items sell out?",
            "answer": "<p>There is no specific answer for this, but last year products sold out within 3 minutes! </p>"
          }
        },
        "cb2406fb-31e4-4d33-a916-e544aad2b0f3": {
          "type": "left",
          "settings": {
            "title": "Are the products Gold-Plated?",
            "answer": "<p>To be honest, we've seen it happen in under 1 minute before. That's why it's so important to be here the second we go live and have your alarms set. There isn't a second to waste.</p>"
          }
        },
        "a66c8486-9aad-422d-b869-1778ba6de9af": {
          "type": "right",
          "settings": {
            "title": "How can I stay in the loop?",
            "answer": "<p>To make sure you get every single answer, follow us on Instagram @nominal - we will be doing Q&As, Live Sessions, and sneak peeks leading up to the sale!</p>"
          }
        }
      },
