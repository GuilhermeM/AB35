            "liquid": "<div class=\"nominal-bf-countdown\" data-sale-end=\"2025-12-23T04:59:00Z\">\n  <div class=\"nominal-bf-countdown__label-row\">\n    <span class=\"nominal-bf-countdown__dot\"></span>\n    <span class=\"nominal-bf-countdown__label\">\n      Free U.S. Express Shipping Above $150 for on-time gifts\n    </span>\n  </div>\n\n  <div class=\"nominal-bf-countdown__timer\">\n    <div class=\"nominal-bf-countdown__unit\">\n      <span class=\"nominal-bf-countdown__value\" data-unit=\"days\">00</span>\n      <span class=\"nominal-bf-countdown__text\">Days</span>\n    </div>\n    <div class=\"nominal-bf-countdown__separator\">:</div>\n    <div class=\"nominal-bf-countdown__unit\">\n      <span class=\"nominal-bf-countdown__value\" data-unit=\"hours\">00</span>\n      <span class=\"nominal-bf-countdown__text\">Hours</span>\n    </div>\n    <div class=\"nominal-bf-countdown__separator\">:</div>\n    <div class=\"nominal-bf-countdown__unit\">\n      <span class=\"nominal-bf-countdown__value\" data-unit=\"minutes\">00</span>\n      <span class=\"nominal-bf-countdown__text\">Mins</span>\n    </div>\n    <div class=\"nominal-bf-countdown__separator\">:</div>\n    <div class=\"nominal-bf-countdown__unit\">\n      <span class=\"nominal-bf-countdown__value\" data-unit=\"seconds\">00</span>\n      <span class=\"nominal-bf-countdown__text\">Secs</span>\n    </div>\n  </div>\n</div>\n\n<style>\n  .nominal-bf-countdown {\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, \"SF Pro Text\",\n      \"Helvetica Neue\", Arial, sans-serif;\n    border-radius: 14px;\n    border: 1px solid #e5ddce;\n    padding: 14px 20px;\n    display: inline-flex;\n    flex-direction: column;\n    gap: 8px;\n    align-items: center;\n    justify-content: center;\n    background: #faf7f2;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.04);\n    animation: fadeUp 400ms ease-out;\n  }\n\n  .nominal-bf-countdown__label-row {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    text-align: center;\n  }\n\n  .nominal-bf-countdown__dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: #c99b4a;\n    box-shadow: 0 0 0 0 rgba(201,155,74,0.6);\n    animation: dotPulse 1.6s ease-out infinite;\n    flex-shrink: 0;\n  }\n\n  .nominal-bf-countdown__label {\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #3e3a34;\n    line-height: 1.35;\n  }\n\n  .nominal-bf-countdown__timer {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .nominal-bf-countdown__value {\n    font-size: 20px;\n    font-weight: 700;\n    color: #b68c42;\n    transition: transform 150ms ease-out;\n  }\n\n  .nominal-bf-countdown__text {\n    font-size: 10px;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    color: #8d8579;\n    margin-top: 2px;\n  }\n\n  .nominal-bf-countdown__separator {\n    font-size: 17px;\n    font-weight: 600;\n    color: #b8afa1;\n    margin-bottom: 10px;\n  }\n\n  .nominal-bf-countdown__value--tick {\n    transform: translateY(-2px);\n  }\n\n  @keyframes dotPulse {\n    0%   { transform: scale(1); box-shadow: 0 0 0 0 rgba(201,155,74,.6); }\n    65%  { transform: scale(1.14); box-shadow: 0 0 0 10px rgba(201,155,74,0); }\n    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(201,155,74,0); }\n  }\n\n  @keyframes fadeUp {\n    from { opacity: 0; transform: translateY(5px); }\n    to   { opacity: 1; transform: translateY(0); }\n  }\n\n  @media (max-width: 600px) {\n    .nominal-bf-countdown__label {\n      font-size: 11px;\n      letter-spacing: 0.14em;\n    }\n  }\n</style>\n\n<script>\n(function() {\n  var container = document.querySelector(\".nominal-bf-countdown\");\n  if (!container) return;\n\n  // Dec 22, 2025 11:59 PM EST → Dec 23, 2025 04:59 UTC\n  var saleEnd = new Date(\"2025-12-23T04:59:00Z\");\n\n  var units = {\n    days: container.querySelector('[data-unit=\"days\"]'),\n    hours: container.querySelector('[data-unit=\"hours\"]'),\n    minutes: container.querySelector('[data-unit=\"minutes\"]'),\n    seconds: container.querySelector('[data-unit=\"seconds\"]')\n  };\n\n  function pad(n) { return n < 10 ? \"0\" + n : n; }\n\n  function animate(el) {\n    el.classList.remove(\"nominal-bf-countdown__value--tick\");\n    void el.offsetWidth;\n    el.classList.add(\"nominal-bf-countdown__value--tick\");\n  }\n\n  function update() {\n    var now = new Date();\n    var diff = saleEnd - now;\n\n    if (diff <= 0) {\n      container.style.display = \"none\";\n      clearInterval(intervalId);\n      return;\n    }\n\n    var t = Math.floor(diff / 1000);\n    var d = Math.floor(t / 86400);\n    var h = Math.floor((t % 86400) / 3600);\n    var m = Math.floor((t % 3600) / 60);\n    var s = t % 60;\n\n    var map = { days: d, hours: h, minutes: m, seconds: s };\n\n    for (var key in map) {\n      var el = units[key];\n      var val = pad(map[key]);\n      if (el && el.textContent !== val) {\n        el.textContent = val;\n        animate(el);\n      }\n    }\n  }\n\n  update();\n  var intervalId = setInterval(update, 1000);\n})();\n</script>"
