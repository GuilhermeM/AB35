    "reviews_rzUxLG": {
      "type": "reviews",
      "blocks": {
        "review_qgADm9": {
          "type": "review",
          "settings": {
            "reviewer_image": "shopify://shop_images/1_cdc3e516-6fd1-42ab-8dbc-ececf55f07d2.jpg",
            "review_heading": "Exceeded My Expectations",
            "short_text": "I bought the Ayatul Kursi Bundle (Men) and I couldn’t be happier with my purchase! The design is abs",
            "full_text": "I bought the Ayatul Kursi Bundle (Men) and I couldn’t be happier with my purchase! The design is absolutely beautiful, the quality feels premium, and it looks even better in person than online. I live in Europe and was really impressed with how quickly it arrived — I ordered on August 14th and received it by August 22nd. Everything about this experience was perfect: from the product itself to the packaging and service. Nominal truly exceeded my expectations!",
            "reviewer_name": "Daniela"
          }
        },
        "review_NAYiyy": {
          "type": "review",
          "settings": {
            "reviewer_image": "shopify://shop_images/4.webp",
            "review_heading": "The Most Beautiful Ring",
            "short_text": "I discovered this shop on instagram because they shared their support for Palestine and many other ",
            "full_text": "I discovered this shop on instagram because they shared their support for Palestine and many other countries who need our voices and support. Came for the humanity, stayed for the quality. I love this ring I wear it every day. Will definitely be buying from here again.",
            "reviewer_name": "Shaylin A."
          }
        },
        "review_WK4P3A": {
          "type": "review",
          "settings": {
            "reviewer_image": "shopify://shop_images/2.webp",
            "review_heading": "Strong, Sturdy, & Pretty!",
            "short_text": "I do garden design & maintenance, so I work with my hands all day everyday - this ring really withst",
            "full_text": "I do garden design & maintenance, so I work with my hands all day everyday - this ring really withstands the tough love!! All my rings eventually either turn my finger green or get super bent, but this one seems to be holding up. Love that it also supports a small Palestinian business! 10/10 💛",
            "reviewer_name": "kristina m."
          }
        },
        "review_GwnLBL": {
          "type": "review",
          "settings": {
            "reviewer_image": "shopify://shop_images/5.avif",
            "review_heading": "Perfect",
            "short_text": "I knew from others the jewelry was beautiful yet still I was extremely impressed by the quality & we",
            "full_text": "I knew from others the jewelry was beautiful yet still I was extremely impressed by the quality & weight of the piece. It's absolutely stunning! I get compliments everytime I wear it which allows for conversations for what truly matters right now, supporting Palestinians both in Gaza & West Bank. I will definitely making more purchases.",
            "reviewer_name": "Kelly s."
          }
        },
        "review_aVHwEh": {
          "type": "review",
          "settings": {
            "reviewer_image": "shopify://shop_images/3.webp",
            "review_heading": "More Beautiful In Person",
            "short_text": "I was so excited to receive my “With Hardship Comes Ease) crescent moon necklace! It’s even more bea",
            "full_text": "I was so excited to receive my “With Hardship Comes Ease) crescent moon necklace! It’s even more beautiful than in the photos. Nominal also shipped my order very quickly, which I appreciate. Judging by the quality and appearance of my necklace, I will certainly be purchasing more Nominal items soon. It’s a bonus that the company donates a portion of the proceeds to feed hungry families in Palestine.",
            "reviewer_name": "Andrea W."
          }
        },
        "review_mKf3NC": {
          "type": "review",
          "settings": {
            "reviewer_image": "shopify://shop_images/6.webp",
            "review_heading": "Beautiful",
            "short_text": "I recently purchased this ring and I'm absolutely delighted with it. The craftsmanship is excellent—",
            "full_text": "I recently purchased this ring and I'm absolutely delighted with it. The craftsmanship is excellent—the details are clean and precise, and the finish gives it a luxurious shine. It feels solid and well-made without being too heavy, making it comfortable for daily wear.",
            "reviewer_name": "Shaista A."
          }
        }
