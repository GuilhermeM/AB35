        },
        "a27144ed-1f98-4413-a8c5-23808803415c": {
          "type": "product-image-with-text",
          "settings": {
            "image": "shopify://shop_images/SG_Lux_Packaging_Shot_2.jpg",
            "title": "A Luxury Unboxing Experience",
            "info": "<p>The piece you're investing in deserves an unboxing experience that we invest in. That's why every Fine Jewelry piece comes hand-packed in our stunning custom-made Fine Jewelry Box and complimentarily includes everything you see here: elegant individual item packaging, a certificate of authenticity, and a gifting bag.</p>",
