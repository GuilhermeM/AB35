0% { \n      filter: drop-shadow(0 0 1px rgba(230, 57, 70, 0.5)); \n      transform: scale(1);\n    }\n    50% { \n      filter: drop-shadow(0 0 5px rgba(230, 57, 70, 0.8)); \n      transform: scale(1.05); \n    }\n  }\n\n  .glowing-flag {\n    animation: flagGlow 5s infinite;\n    display: inline-block;\n    margin: 0 3px;\n  }\n\n  @media (max-width: 480px) {\n    #donation-message h1 {\n      font-size: 13px;\n    }\n    #donation-message {\n      padding: 10px 12px;\n    }\n  }\n</style>"
