        "bccc9cf9-5698-40ff-b4f1-4a28cc3d3d50": {
          "type": "product-image-with-text",
          "settings": {
            "image": "shopify://shop_images/Copy_of_Rings_3.jpg",
            "title": "Italian Made",
            "info": "<p>It’s no secret that Italian-made jewelry is second to none. As the home to expert jewelers devoting their lives to the craft, Italy produces the highest quality chains in the world. That is why we only work with the most enduring and premium quality materials straight from Italy.</p>",
            "btn_label": "",
            "btn_url": "",
            "text_align": "left",
            "grid_layout": "right",
            "padding_top": 0,
            "padding_bottom": 0,
            "title_color": "",
